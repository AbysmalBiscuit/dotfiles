#!/usr/bin/env python3
"""Decrypt the age-encrypted secrets file, open it in $EDITOR, re-encrypt it.

The work is done by edit_secrets.{sh,ps1}.tmpl in the chezmoi source directory,
which needs rendering first because the age identity and recipient come from
template data. Re-inits afterwards so the config file picks up the new secrets.

chezmoi dispatches `chezmoi edit-secrets` to whatever `chezmoi-edit-secrets`
resolves to on PATH.
"""

from __future__ import annotations

import argparse
import sys

from chezmoi_plugin import SCRIPT_SUFFIX, chezmoi_init, render, run, run_rendered, source_dir


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="chezmoi edit-secrets",
        description="Decrypt the secrets file, open it in $EDITOR, re-encrypt it.",
    )
    return parser.parse_args()


def main() -> int:
    parse_args()
    template = source_dir() / f"edit_secrets{SCRIPT_SUFFIX}.tmpl"
    if code := run_rendered(render(template)):
        return code
    return chezmoi_init()


if __name__ == "__main__":
    sys.exit(run(main))
