#!/usr/bin/env python3
"""Recover zccache after builds fail with "daemon unavailable" (exit 125).

  zccache-fix                 fix the daemon and the nearest cargo target dir
  zccache-fix path/to/target  ... and these target dirs instead

Each step clears one way a healthy-looking zccache still refuses a build:

- a second daemon, started without XDG_RUNTIME_DIR, holds the cache root's
  writer lock on a socket this shell never looks at, so every new daemon is
  refused. `zccache stop` only reaches the daemon on this shell's socket, so
  the rest are killed by process name.
- the spawn breaker's `*.spawn-failed` marker fails every client for up to ten
  minutes after a failed spawn, even once a daemon is up.
- cargo caches rustc probe output in `target/.rustc_info.json`, failures
  included, and replays a cached exit 125 without calling zccache again.
- on Windows zccache starts its daemon inside the caller's Job Object, so a
  daemon started from an agent's shell dies when that shell's job closes. The
  fresh daemon is started through WMI instead, which puts it in no job. On
  Linux it goes into its own systemd scope for the same reason.

Killing the daemons aborts compiles running in other checkouts.
"""

from __future__ import annotations

import argparse
import csv
import io
import json
import os
import shutil
import signal
import subprocess
import sys
import time
from pathlib import Path

PROG = "zccache-fix"
DAEMON_NAME = "zccache-daemon"
IS_WINDOWS = sys.platform == "win32"


def log(message: str) -> None:
    print(f"{PROG}: {message}", flush=True)


def daemon_pids() -> list[int]:
    if IS_WINDOWS:
        listing = subprocess.run(
            ["tasklist", "/FO", "CSV", "/NH"], capture_output=True, text=True, check=False
        ).stdout
        # A daemon whose binary was replaced while running shows up as
        # zccache-daemon.exe.old.<n>, so match on the prefix.
        return [
            int(row[1])
            for row in csv.reader(io.StringIO(listing))
            if len(row) > 1 and row[0].startswith(DAEMON_NAME)
        ]
    listing = subprocess.run(
        ["pgrep", "-x", DAEMON_NAME], capture_output=True, text=True, check=False
    ).stdout
    return [int(pid) for pid in listing.split()]


def kill(pid: int, *, force: bool) -> None:
    if IS_WINDOWS:
        subprocess.run(
            ["taskkill", "/PID", str(pid), *(["/F"] if force else [])],
            capture_output=True,
            check=False,
        )
        return
    try:
        os.kill(pid, signal.SIGKILL if force else signal.SIGTERM)
    except ProcessLookupError:
        pass


def stop_daemons(zccache: str) -> None:
    subprocess.run([zccache, "stop"], capture_output=True, check=False)
    pids = daemon_pids()
    if not pids:
        log("no daemon left running")
        return
    for pid in pids:
        log(f"stopping daemon {pid}")
        kill(pid, force=False)
    deadline = time.monotonic() + 5
    while daemon_pids() and time.monotonic() < deadline:
        time.sleep(0.25)
    for pid in daemon_pids():
        log(f"daemon {pid} ignored the stop, killing it")
        kill(pid, force=True)


def stale_daemon_files() -> list[Path]:
    if IS_WINDOWS:
        return sorted(Path.home().glob(".zccache/v*/*.spawn-failed"))
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}")
    socket_dirs = [runtime / "zccache", *Path("/tmp").glob("zccache-*")]
    return sorted(
        path
        for directory in socket_dirs
        for pattern in ("*.spawn-failed", "sock-*")
        for path in directory.glob(pattern)
    )


def nearest_target_dir() -> Path | None:
    if configured := os.environ.get("CARGO_TARGET_DIR"):
        return Path(configured)
    for directory in (Path.cwd(), *Path.cwd().parents):
        if (directory / "target").is_dir():
            return directory / "target"
    return None


def has_cached_zccache_failure(rustc_info: Path) -> bool:
    try:
        outputs = json.loads(rustc_info.read_text(encoding="utf-8")).get("outputs", {})
    except (OSError, ValueError):
        return False
    return any(
        not output.get("success", True) and "zccache" in output.get("stderr", "")
        for output in outputs.values()
    )


def clear_cached_probes(target_dirs: list[Path]) -> None:
    for target_dir in target_dirs:
        rustc_info = target_dir / ".rustc_info.json"
        if has_cached_zccache_failure(rustc_info):
            log(f"removing cached failed rustc probe {rustc_info}")
            rustc_info.unlink()
        else:
            log(f"no cached zccache failure in {rustc_info}")


def spawn_outside_job(argv: list[str]) -> int:
    """Start `argv` through WMI so it inherits no Job Object; returns its pid."""
    create = (
        "$r = Invoke-CimMethod -ClassName Win32_Process -MethodName Create"
        " -Arguments @{CommandLine=$env:ZCCACHE_FIX_COMMAND_LINE};"
        " if ($r.ReturnValue -ne 0) { exit $r.ReturnValue }; $r.ProcessId"
    )
    created = subprocess.run(
        ["powershell", "-NoProfile", "-NonInteractive", "-Command", create],
        env={**os.environ, "ZCCACHE_FIX_COMMAND_LINE": subprocess.list2cmdline(argv)},
        capture_output=True,
        text=True,
        check=True,
    )
    return int(created.stdout.strip())


def in_job(pid: int) -> bool | None:
    import ctypes
    from ctypes import wintypes

    kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
    kernel32.OpenProcess.restype = wintypes.HANDLE
    process_query_limited_information = 0x1000
    handle = kernel32.OpenProcess(process_query_limited_information, False, pid)
    if not handle:
        return None
    try:
        result = wintypes.BOOL()
        if not kernel32.IsProcessInJob(handle, None, ctypes.byref(result)):
            return None
        return bool(result.value)
    finally:
        kernel32.CloseHandle(handle)


def start_daemon(zccache: str) -> int:
    if sys.platform == "win32":
        return start_daemon_windows(zccache)
    if sys.platform == "linux":
        return start_daemon_linux(zccache)
    return start_daemon_macos(zccache)


def start_daemon_linux(zccache: str) -> int:
    # A transient scope gives the daemon its own cgroup, so tearing down the
    # agent or terminal unit that ran this does not take the daemon with it.
    systemd_run = shutil.which("systemd-run")
    if systemd_run is not None:
        scoped = subprocess.run(
            [systemd_run, "--user", "--scope", "--quiet", "--collect", zccache, "start"],
            check=False,
        )
        if scoped.returncode == 0:
            return 0
        log("systemd-run --user failed, starting the daemon directly")
    return subprocess.run([zccache, "start"], check=False).returncode


def start_daemon_macos(zccache: str) -> int:
    # zccache already detaches the daemon with setsid, and macOS has no job or
    # cgroup that would reap it with the caller.
    return subprocess.run([zccache, "start"], check=False).returncode


def start_daemon_windows(zccache: str) -> int:
    spawn_outside_job([zccache, "start"])
    deadline = time.monotonic() + 30
    while True:
        status = subprocess.run([zccache, "status"], capture_output=True, check=False)
        if status.returncode == 0:
            break
        if time.monotonic() >= deadline:
            log("daemon did not come up within 30s")
            return status.returncode
        time.sleep(0.5)

    for pid in daemon_pids():
        if in_job(pid):
            log(
                f"daemon {pid} is inside a Job Object, so a build started it first"
                " and it dies with that build's shell; rerun once no build is running"
            )
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        prog=PROG, description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument(
        "target_dirs",
        nargs="*",
        type=Path,
        help="cargo target dirs to clear (default: CARGO_TARGET_DIR or the nearest ./target)",
    )
    args = parser.parse_args()

    zccache = shutil.which("zccache")
    if zccache is None:
        log("zccache is not on PATH")
        return 1

    stop_daemons(zccache)

    for path in stale_daemon_files():
        log(f"removing {path}")
        path.unlink(missing_ok=True)

    target_dirs = args.target_dirs or [d for d in [nearest_target_dir()] if d is not None]
    clear_cached_probes(target_dirs)

    log("starting a fresh daemon")
    started = start_daemon(zccache)
    if started != 0:
        return started
    return subprocess.run([zccache, "status"], check=False).returncode


if __name__ == "__main__":
    sys.exit(main())
