#!/usr/bin/env python3
"""Assign a merge strategy to every live agent-config key no rule covers.

A launcher for .agentcfg/promote.py in the chezmoi source directory, which
chezmoi also runs as its apply.pre hook. promote.py puts its own directory on
sys.path, so running it in this interpreter needs no further setup.

chezmoi dispatches `chezmoi agents ...` to whatever `chezmoi-agents` resolves to
on PATH, so every argument here reaches promote.py unchanged.
"""

from __future__ import annotations

import os
import runpy
import subprocess
import sys
from pathlib import Path


def source_dir() -> Path:
    if env := os.environ.get("CHEZMOI_SOURCE_DIR"):
        return Path(env)
    result = subprocess.run(
        ["chezmoi", "source-path"],
        capture_output=True,
        text=True,
        check=True,
    )
    return Path(result.stdout.strip())


def main() -> int:
    try:
        script = source_dir() / ".agentcfg" / "promote.py"
    except (OSError, subprocess.CalledProcessError) as err:
        print(f"cannot locate the chezmoi source directory: {err}", file=sys.stderr)
        return 1
    if not script.is_file():
        print(f"{script}: not found", file=sys.stderr)
        return 1

    sys.argv = [str(script), *sys.argv[1:]]
    runpy.run_path(str(script), run_name="__main__")
    return 0


if __name__ == "__main__":
    sys.exit(main())
