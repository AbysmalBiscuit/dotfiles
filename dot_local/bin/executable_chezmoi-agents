#!/usr/bin/env python3
"""Assign a merge strategy to every live agent-config key no rule covers.

A launcher for .agentcfg/promote.py in the chezmoi source directory, which
chezmoi also runs as its apply.pre hook. promote.py puts its own directory on
sys.path, so running it in this interpreter needs no further setup.

chezmoi dispatches `chezmoi agents ...` to whatever `chezmoi-agents` resolves to
on PATH, so every argument here reaches promote.py unchanged.
"""

from __future__ import annotations

import runpy
import sys

from chezmoi_plugin import PluginError, run, source_dir


def main() -> int:
    script = source_dir() / ".agentcfg" / "promote.py"
    if not script.is_file():
        raise PluginError(f"{script}: not found")

    sys.argv = [str(script), *sys.argv[1:]]
    runpy.run_path(str(script), run_name="__main__")
    return 0


if __name__ == "__main__":
    sys.exit(run(main))
