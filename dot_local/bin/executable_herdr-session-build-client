#!/usr/bin/env python3
"""Build the client used by herdr-session without replacing stock herdr."""

import argparse
import os
from pathlib import Path
import shutil
import subprocess
import tempfile


COMMIT = "b99002ac99b09e00b4ca692436cb15a6b0d676f1"


def main():
    executable_suffix = ".exe" if os.name == "nt" else ""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--source", type=Path, help="local, unmodified herdr checkout at the pinned commit"
    )
    parser.add_argument(
        "--output",
        type=Path,
        default=Path.home() / ".local/bin" / f"herdr-session-client{executable_suffix}",
    )
    args = parser.parse_args()
    patch = Path(__file__).resolve().parent.parent / "share/herdr-session/startup-target.patch"
    if not patch.is_file():
        parser.error(f"missing client patch: {patch}")
    for tool in ("git", "cargo", "zig"):
        if not shutil.which(tool):
            parser.error(f"{tool} is required to build the client")
    cache = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "herdr-session"
    cache.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="build-", dir=cache) as temporary:
        source = Path(temporary) / "source"
        if args.source:
            original = args.source.expanduser().resolve()
            revision = subprocess.check_output(
                ["git", "-C", str(original), "rev-parse", "HEAD"], text=True
            ).strip()
            if revision != COMMIT:
                parser.error(f"source must be at {COMMIT}, got {revision}")
            subprocess.run(
                ["git", "-C", str(original), "diff", "--exit-code", "HEAD", "--"], check=True
            )
            shutil.copytree(
                original,
                source,
                ignore=shutil.ignore_patterns(".git", "target", "zig-out", ".zig-cache"),
            )
            subprocess.run(["git", "init", "--quiet", str(source)], check=True)
        else:
            subprocess.run(["git", "init", "--quiet", str(source)], check=True)
            subprocess.run(
                [
                    "git",
                    "-C",
                    str(source),
                    "fetch",
                    "--depth=1",
                    "https://github.com/herdrdev/herdr.git",
                    COMMIT,
                ],
                check=True,
            )
            subprocess.run(
                ["git", "-C", str(source), "checkout", "--detach", "FETCH_HEAD"], check=True
            )
        subprocess.run(["git", "-C", str(source), "apply", "--check", str(patch)], check=True)
        subprocess.run(["git", "-C", str(source), "apply", str(patch)], check=True)
        env = {**os.environ, "CARGO_TARGET_DIR": str(cache / "target"), "CARGO_INCREMENTAL": "0"}
        subprocess.run(
            [
                "cargo",
                "+stable",
                "build",
                "--release",
                "--locked",
                "--manifest-path",
                str(source / "Cargo.toml"),
            ],
            env=env,
            check=True,
        )
        output = args.output.expanduser().resolve()
        output.parent.mkdir(parents=True, exist_ok=True)
        with tempfile.NamedTemporaryFile(
            prefix=f".{output.name}-", dir=output.parent, delete=False
        ) as temporary_binary:
            staging = Path(temporary_binary.name)

        release_dir = cache / "target" / "release"
        binary = release_dir / f"herdr{executable_suffix}"

        if not binary.is_file():
            msg = f"Cannot find built binary in: {release_dir}"
            raise ValueError(msg)

        try:
            shutil.copyfile(binary, staging)
            staging.chmod(0o755)
            staging.replace(output)
        finally:
            staging.unlink(missing_ok=True)
        print(f"Installed {output}")


if __name__ == "__main__":
    main()
