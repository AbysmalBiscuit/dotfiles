#!/usr/bin/env python3
"""Open the checkout you are standing in as a Herdr workspace.

Bare `herdr` restores whatever the session was showing when it last ran, so
launching it from a worktree drops you wherever you happened to be before.
This resolves the checkout from git and opens its workspace.

  herdr-session                create or join this checkout's workspace
  herdr-session list           show this workspace's tabs and agents
  herdr-session new            choose an installed coding agent
  herdr-session new shell      ... plus a fresh tab at a shell prompt
  herdr-session new claude     ... plus a fresh tab running an agent

The calling terminal keeps its own session: Herdr's workspaces and tabs are
made without focus, so no Herdr client moves. Alacritree, which lists Herdr's
panes in its own sidebar, is then pointed at the reported tab, the same move
as clicking that row. Pass --no-attach to leave it where it is.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import time
import tomllib
from pathlib import Path
from typing import NoReturn

PROG = "herdr-session"
SERVER_START_TIMEOUT = 15.0
SERVER_POLL = 0.1
PANE_DETECT_TIMEOUT = 3.0
PANE_DETECT_POLL = 0.1
AGENT_NAME_MAX = 32
SUBCOMMANDS = ("open", "new", "list", "close")
DELETED_SUFFIX = " (deleted)"
AGENT_BINARIES = {
    kind: kind
    for kind in (
        "pi",
        "claude",
        "codex",
        "gemini",
        "devin",
        "cline",
        "omp",
        "mastracode",
        "opencode",
        "kimi",
        "droid",
        "amp",
        "grok",
        "hermes",
        "kilo",
        "qodercli",
        "qwen",
        "maki",
        "muse",
    )
} | {
    "cursor": "cursor-agent",
    "antigravity": "agy",
    "github-copilot": "copilot",
    "kiro": "kiro-cli",
}


def die(message: str) -> NoReturn:
    print(f"{PROG}: {message}", file=sys.stderr)
    raise SystemExit(1)


def warn(message: str) -> None:
    print(f"{PROG}: {message}", file=sys.stderr)


def run(cmd: list[str], **kwargs) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        cmd, capture_output=True, text=True, encoding="utf-8", errors="replace", **kwargs
    )


def same_path(a: str | os.PathLike, b: str | os.PathLike) -> bool:
    return os.path.normcase(os.path.normpath(a)) == os.path.normcase(os.path.normpath(b))


def under(child: str, parent: str) -> bool:
    child, parent = os.path.normpath(child), os.path.normpath(parent)
    return child == parent or child.startswith(parent + os.sep)


def pane_cwd(pane: dict) -> str:
    """A pane's directory, with the marker the kernel adds once it is unlinked.

    A worktree removal hook runs after the checkout is gone, and the shells
    still sitting in it then report `/path/to/it (deleted)`.
    """
    cwd = pane.get("cwd") or ""
    return cwd[: -len(DELETED_SUFFIX)] if cwd.endswith(DELETED_SUFFIX) else cwd


def checkout_root(directory: Path) -> Path | None:
    """The worktree root `directory` sits in, or None outside a repository."""
    done = run(["git", "-C", str(directory), "rev-parse", "--show-toplevel"])
    if done.returncode != 0:
        return None
    root = done.stdout.strip()
    return Path(root).resolve() if root else None


# --- talking to herdr --------------------------------------------------------


class Herdr:
    """One run's connection to a Herdr server; every reply is JSON on stdout."""

    def __init__(self, session: str | None) -> None:
        self.exe = shutil.which("herdr") or die("herdr is not on PATH")
        self.session = session
        self._started_server = False

    def _argv(self, args: tuple[str, ...] = ()) -> list[str]:
        # --session is stripped from anywhere in the command line before
        # subcommand dispatch, so it is accepted in front of any command.
        prefix = ["--session", self.session] if self.session else []
        return [self.exe, *prefix, *args]

    def call(self, *args: str) -> tuple[dict | None, str, str]:
        """Returns (result, error_code, message); result is None on failure."""
        done = run(self._argv(args))
        # Results come back on stdout, but a refused request is JSON on stderr.
        payload: dict = {}
        for stream in (done.stdout, done.stderr):
            try:
                parsed = json.loads(stream or "")
            except (json.JSONDecodeError, ValueError):
                continue
            if isinstance(parsed, dict):
                payload = parsed
                break
        error = payload.get("error")
        if isinstance(error, dict):
            return None, str(error.get("code") or ""), str(error.get("message") or "").strip()
        result = payload.get("result")
        if done.returncode != 0 or not isinstance(result, dict):
            text = ((done.stdout or "") + (done.stderr or "")).strip()
            return None, "", text or f"herdr {' '.join(args)} failed"
        return result, "", ""

    def require(self, *args: str) -> dict:
        """A call that must succeed, starting the server once if it is down."""
        result, code, message = self.call(*args)
        if result is None and code == "server_not_running" and not self._started_server:
            self.start_server()
            result, code, message = self.call(*args)
        if result is None:
            die(f"{' '.join(args)}: {message or code or 'failed'}")
        return result

    def start_server(self) -> None:
        if os.environ.get("NO_COLOR") and os.environ.get("TERM") == "dumb":
            die("start Herdr from an interactive terminal first; this environment disables pane colors")
        self._started_server = True
        warn("no server running, starting one")
        subprocess.Popen(
            self._argv(("server",)),
            start_new_session=True,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        deadline = time.monotonic() + SERVER_START_TIMEOUT
        while time.monotonic() < deadline:
            result, code, _ = self.call("workspace", "list")
            if result is not None or code != "server_not_running":
                return
            time.sleep(SERVER_POLL)
        die("the server did not come up in time")


# --- workspaces --------------------------------------------------------------


def open_checkout(herdr: Herdr, root: Path, label: str | None) -> tuple[str, bool]:
    """Find or create a checkout's workspace without changing client focus."""
    listing = herdr.require("worktree", "list", "--cwd", str(root))
    entry = next(
        (w for w in listing.get("worktrees", []) if same_path(w.get("path", ""), root)),
        None,
    )
    if entry is None:
        # Herdr found a repository but not this checkout: a submodule, or a
        # worktree registered since the repo was last read.
        return open_directory(herdr, root, label)

    # Worktree actions are refused from a linked checkout: they have to start
    # from the repo the worktrees hang off, which the listing reports.
    source = listing.get("source", {}).get("repo_root") or str(root)
    args = ["worktree", "open", "--cwd", source, "--path", str(root), "--no-focus"]
    # A label renames whichever workspace the call lands on, so send it only
    # when the checkout is not already open under a name the user chose.
    if label and not entry.get("open_workspace_id"):
        args += ["--label", label]
    result = herdr.require(*args)
    return (
        result.get("workspace", {}).get("workspace_id", "?"),
        not result.get("already_open", False),
    )


def open_directory(herdr: Herdr, directory: Path, label: str | None) -> tuple[str, bool]:
    """Find or create a workspace, matched by the cwd of an open pane."""
    panes = herdr.require("pane", "list").get("panes", [])
    existing = next((p for p in panes if same_path(pane_cwd(p), directory)), None)
    if existing:
        workspace_id = existing["workspace_id"]
        return workspace_id, False

    args = ["workspace", "create", "--cwd", str(directory), "--no-focus"]
    if label:
        args += ["--label", label]
    result = herdr.require(*args)
    return result.get("workspace", {}).get("workspace_id", "?"), True


def active_tab(herdr: Herdr, workspace_id: str) -> str | None:
    """The tab a workspace was last showing, which a fresh one has too."""
    workspaces = herdr.require("workspace", "list").get("workspaces", [])
    entry = next((w for w in workspaces if w.get("workspace_id") == workspace_id), None)
    return (entry or {}).get("active_tab_id")


# --- alacritree --------------------------------------------------------------


def alacritree(exe: str, *args: str) -> tuple[dict, str]:
    """Returns (reply, message); the message is non-empty only on failure."""
    done = run([exe, *args, "--json"])
    try:
        reply = json.loads(done.stdout or "")
    except (json.JSONDecodeError, ValueError):
        reply = None
    if not isinstance(reply, dict):
        text = ((done.stdout or "") + (done.stderr or "")).strip()
        return {}, text or f"{' '.join(args)} failed"
    if error := reply.get("error"):
        return {}, str(error)
    if done.returncode != 0:
        return {}, f"{' '.join(args)} failed"
    return reply, ""


def detected_pane(panes: list[dict], session: str, tab_id: str) -> dict | None:
    """The multiplexer record Alacritree holds for a Herdr tab."""
    for pane in panes:
        mux = pane.get("multiplexer") or {}
        if (
            mux.get("name") == "herdr"
            and mux.get("session") == session
            and mux.get("tab_id") == tab_id
        ):
            return mux
    return None


def attach_tab(herdr: Herdr, tab_id: str) -> None:
    """Open the tab in Alacritree, as clicking its sidebar row does.

    Alacritree discovers Herdr's panes on its own schedule, so a tab created a
    moment ago is not in its list yet and the pane is waited for.
    """
    exe = os.environ.get("ALACRITREE_EXE") or shutil.which("alacritree")
    if not exe:
        return
    session = herdr.session or "default"
    deadline = time.monotonic() + PANE_DETECT_TIMEOUT
    while True:
        listing, message = alacritree(exe, "multiplexer", "list")
        if message:
            warn(f"could not open tab {tab_id} in alacritree: {message}")
            return
        mux = detected_pane(listing.get("panes", []), session, tab_id)
        if mux:
            break
        if time.monotonic() >= deadline:
            warn(f"could not open tab {tab_id} in alacritree: no pane for it")
            return
        time.sleep(PANE_DETECT_POLL)

    reply, message = alacritree(exe, "multiplexer", "attach", mux["side"], mux["terminal_id"])
    if message:
        warn(f"could not open tab {tab_id} in alacritree: {message}")
        return
    print(f"alacritree session {reply.get('session_id', '?')}  attached  {tab_id}")


# --- agents ------------------------------------------------------------------


def installed_agents() -> list[str]:
    config_home = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    has_file = config_home / "chezmoi/has.toml"
    try:
        with has_file.open("rb") as stream:
            has = tomllib.load(stream)
    except FileNotFoundError:
        has = {}
    except (OSError, tomllib.TOMLDecodeError) as error:
        die(f"{has_file}: {error}")
    return sorted(
        kind
        for kind, binary in AGENT_BINARIES.items()
        if has.get(binary.replace("-", "_"), True) and shutil.which(binary)
    )


def choose_agent() -> str | None:
    choices = [*installed_agents(), "shell"]
    if not sys.stdin.isatty():
        die(f"choose an agent explicitly: {PROG} new {{{','.join(choices)}}}")
    if picker := shutil.which("fzf"):
        picked = subprocess.run(
            [picker, "--prompt=Agent> ", "--height=40%", "--reverse", "--no-multi"],
            input="\n".join(choices),
            text=True,
            stdout=subprocess.PIPE,
        )
        if picked.returncode in (1, 130):
            return None
        if picked.returncode:
            die("agent picker failed")
        choice = picked.stdout.strip()
    else:
        for index, kind in enumerate(choices, 1):
            print(f"{index}. {kind}", file=sys.stderr)
        try:
            choice = input("Agent (name or number, empty to cancel): ").strip()
        except (EOFError, KeyboardInterrupt):
            return None
        if not choice:
            return None
        if choice.isdecimal() and 1 <= int(choice) <= len(choices):
            choice = choices[int(choice) - 1]
    if choice not in choices:
        die(f"unknown agent selection: {choice}")
    return choice


def agent_name(herdr: Herdr, base: str) -> str:
    """A name derived from the checkout that no live agent already answers to."""
    slug = re.sub(r"[^a-z0-9_-]+", "-", base.lower()).strip("-") or "agent"
    if not slug[0].isalpha():
        slug = f"a-{slug}"
    slug = slug[:AGENT_NAME_MAX]
    taken = {a.get("name") for a in herdr.require("agent", "list").get("agents", [])}
    if slug not in taken:
        return slug
    for n in range(2, 100):
        suffix = f"-{n}"
        candidate = slug[: AGENT_NAME_MAX - len(suffix)] + suffix
        if candidate not in taken:
            return candidate
    die(f"no free agent name based on {slug!r}")


def new_tab(herdr: Herdr, workspace_id: str, cwd: Path, kind: str, extra: list[str]) -> str:
    result = herdr.require(
        "tab", "create", "--workspace", workspace_id, "--cwd", str(cwd), "--no-focus"
    )
    tab_id = result.get("tab", {}).get("tab_id") or die("herdr created a tab without an id")
    if kind == "shell":
        print(f"tab {tab_id}  shell  {cwd}")
        return tab_id

    pane_id = result.get("root_pane", {}).get("pane_id")
    if not pane_id:
        die("herdr created a tab without a root pane to start the agent in")
    name = agent_name(herdr, cwd.name)
    args = ["agent", "start", name, "--kind", kind, "--pane", pane_id]
    if extra:
        args += ["--", *extra]
    started, code, message = herdr.call(*args)
    if started is None and code != "agent_not_ready":
        herdr.call("tab", "close", tab_id)
        die(f"could not start {kind}: {message or code or 'failed'}")
    if code == "agent_not_ready":
        warn(f"{kind} as {name} is waiting for startup input in tab {tab_id}")
    print(f"tab {tab_id}  {kind} as {name}  {cwd}")
    return tab_id


# --- commands ----------------------------------------------------------------


def list_sessions(herdr: Herdr, args: argparse.Namespace) -> int:
    directory = Path(args.path or Path.cwd()).expanduser().resolve()
    if not directory.is_dir():
        die(f"{directory}: not a directory")
    root = checkout_root(directory) or directory
    result, code, message = herdr.call("api", "snapshot")
    if result is None:
        if code != "server_not_running":
            die(message or code or "could not list sessions")
        snapshot = {}
    else:
        snapshot = result["snapshot"]
    panes = snapshot.get("panes", [])
    current_id = None
    if os.environ.get("HERDR_ENV") == "1" and not args.path and not args.session:
        current_id = os.environ.get("HERDR_WORKSPACE_ID")
    matching = {
        workspace["workspace_id"]
        for workspace in snapshot.get("workspaces", [])
        if (
            workspace["workspace_id"] == current_id
            if current_id
            else (
                same_path((workspace.get("worktree") or {}).get("checkout_path", ""), root)
                or any(
                    pane["workspace_id"] == workspace["workspace_id"]
                    and same_path(pane_cwd(pane), root)
                    for pane in panes
                )
            )
        )
    }
    tabs = {tab["tab_id"]: tab for tab in snapshot.get("tabs", [])}
    agents = {agent["pane_id"]: agent for agent in snapshot.get("agents", [])}
    rows = [
        {
            "tab_id": pane["tab_id"],
            "tab": tabs.get(pane["tab_id"], {}).get("label", ""),
            "pane_id": pane["pane_id"],
            "agent": pane.get("agent") or "shell",
            "name": agents.get(pane["pane_id"], {}).get("name") or pane.get("label") or "",
            "status": pane.get("agent_status", ""),
            "cwd": pane_cwd(pane),
        }
        for pane in panes
        if pane["workspace_id"] in matching
    ]
    if args.json:
        print(json.dumps(rows))
    elif rows:
        columns = ("tab_id", "tab", "pane_id", "agent", "name", "status", "cwd")
        cells = [
            [re.sub(r"[\x00-\x1f\x7f-\x9f]", " ", str(row[key])) for key in columns] for row in rows
        ]
        table = [[key.upper() for key in columns], *cells]
        widths = [max(len(row[i]) for row in table) for i in range(len(columns))]
        for row in table:
            print("  ".join(value.ljust(width) for value, width in zip(row, widths)).rstrip())
    else:
        print(f"No sessions in {root}")
    return 0


def workspace_for(herdr: Herdr, args: argparse.Namespace) -> tuple[Path, str]:
    """Ensure this checkout has a workspace. Returns (directory, id)."""
    directory = Path(args.path or Path.cwd()).expanduser().resolve()
    if not directory.is_dir():
        die(f"{directory}: not a directory")
    root = checkout_root(directory)
    label = args.label or (root or directory).name
    if root:
        workspace_id, created = open_checkout(herdr, root, label)
    else:
        root, (workspace_id, created) = directory, open_directory(herdr, directory, label)
    print(f"workspace {workspace_id}  {'created' if created else 'existing'}  {root}")
    return directory, workspace_id


def close_workspaces(herdr: Herdr, args: argparse.Namespace) -> int:
    """Close every workspace whose panes sit in a directory, gone or not.

    Built for a worktree removal hook, so a Herdr that is not running is not
    worth starting and an unopened checkout is not worth complaining about.
    """
    target = str(Path(args.path or Path.cwd()).expanduser().resolve())
    panes, code, message = herdr.call("pane", "list")
    if panes is None:
        if code != "server_not_running":
            warn(f"pane list: {message or code or 'failed'}")
        return 0

    workspace_ids = dict.fromkeys(
        p["workspace_id"] for p in panes.get("panes", []) if under(pane_cwd(p), target)
    )
    for workspace_id in workspace_ids:
        result, code, message = herdr.call("workspace", "close", workspace_id)
        if result is None:
            warn(f"could not close {workspace_id}: {message or code or 'failed'}")
        else:
            print(f"workspace {workspace_id}  closed  {target}")
    return 0


def main() -> int:
    shared = argparse.ArgumentParser(add_help=False)
    shared.add_argument("--session", help="use this named session instead of the default")
    shared.add_argument("--path", help="directory to open (default: the current one)")
    shared.add_argument("--label", help="workspace name, used only when creating one")
    shared.add_argument(
        "--no-attach", action="store_true", help="leave Alacritree on the session it is showing"
    )

    # `shared` is a parent of the top-level parser only so that a bare
    # `--help` documents the options; every run reaches a subparser, which
    # parses them for real.
    parser = argparse.ArgumentParser(
        prog=PROG,
        parents=[shared],
        description="Open the current checkout as a Herdr workspace.",
    )
    sub = parser.add_subparsers(dest="command")
    sub.add_parser(
        "open",
        parents=[shared],
        help="create or join the workspace (the default)",
        description="Create or join the current checkout's workspace and open it in Alacritree.",
    )
    sub.add_parser(
        "close",
        parents=[shared],
        help="close the workspaces for a checkout",
        description="Close workspaces whose panes are in the current directory or its subdirectories, terminating their processes.",
    )
    p_list = sub.add_parser(
        "list",
        parents=[shared],
        help="show this workspace's tabs and agents",
        description="List the current workspace's tabs, panes, and agents with their status and working directories.",
    )
    p_list.add_argument("--json", action="store_true", help="print structured session rows")
    p_new = sub.add_parser(
        "new",
        parents=[shared],
        help="also open a tab with a shell or agent",
        description="Open a new tab in this workspace with a shell or coding agent. If no agent is specified, choose one from the installed agents.",
    )
    p_new.add_argument(
        "kind", nargs="?", help="installed agent or shell (default: interactive picker)"
    )
    p_new.add_argument(
        "--list-agents", action="store_true", help="print installed agent choices and exit"
    )
    p_new.add_argument("agent_args", nargs="*", help="after --, passed through to the agent")

    # Options live on the subparsers, so a bare run needs the default
    # subcommand spliced in before argparse sees the rest.
    argv = sys.argv[1:]
    if not argv or (argv[0] not in SUBCOMMANDS and argv[0] not in ("-h", "--help")):
        argv = ["open", *argv]

    separator = argv.index("--") if "--" in argv else len(argv)
    args = parser.parse_args(argv[:separator])
    if separator < len(argv):
        if args.command != "new":
            parser.error("agent arguments are only accepted by new")
        args.agent_args.extend(argv[separator + 1 :])
    for stream in (sys.stdout, sys.stderr):
        stream.reconfigure(encoding="utf-8", errors="replace")

    if args.command == "new":
        if args.list_agents:
            print("\n".join(installed_agents()))
            return 0
        if args.kind is None:
            args.kind = choose_agent()
            if args.kind is None:
                return 0
        elif args.kind != "shell" and args.kind not in installed_agents():
            die(f"{args.kind} is not an installed, supported agent; use new --list-agents")
        if args.kind == "shell" and args.agent_args:
            parser.error("shell does not accept agent arguments")

    herdr = Herdr(args.session)
    if args.command == "close":
        return close_workspaces(herdr, args)
    if args.command == "list":
        return list_sessions(herdr, args)

    directory, workspace_id = workspace_for(herdr, args)
    tab_id = (
        new_tab(herdr, workspace_id, directory, args.kind, args.agent_args)
        if args.command == "new"
        else active_tab(herdr, workspace_id)
    )
    if tab_id and not args.no_attach:
        attach_tab(herdr, tab_id)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
