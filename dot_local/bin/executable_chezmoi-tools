#!/usr/bin/env python3
"""Report and install the tools inventoried in the chezmoi source directory.

Reads .chezmoidata/tools.toml, and wsl_tools.toml as well under WSL, then checks
each tool's commands against PATH. Installing runs the tool's install_command,
or a command derived from its lang when it declares none.

chezmoi dispatches `chezmoi tools ...` to whatever `chezmoi-tools` resolves to on
PATH, so every subcommand here is reachable under either name.
"""

from __future__ import annotations

import argparse
import difflib
import os
import shlex
import shutil
import subprocess
import sys
import tomllib
from dataclasses import dataclass
from pathlib import Path

# Package managers whose install invocation follows from the lang alone. go is
# absent because its install path needs a module URL that the name doesn't carry,
# and every other lang installs through a system package manager.
DERIVED_INSTALL: dict[str, tuple[str, ...]] = {
    "bun": ("bun", "add", "-g"),
    "python": ("uv", "tool", "install"),
    "rust": ("cargo", "install"),
}

# ocargo forwards to cargo with this machine's optimization flags applied.
CARGO_WRAPPER = "ocargo"

# An install_command starting with this documents why the tool has no install of
# its own, rather than naming a command to run.
UNINSTALLABLE_PREFIX = "NONE:"

# Control operators only a shell can interpret. A command holding one has to run
# through the shell instead of being split into an argv.
SHELL_OPERATORS: frozenset[str] = frozenset("|&;<>()$`\n")

NAME_COLUMN_MAX = 28


class ToolsError(Exception):
    """A failure worth reporting as a message rather than a traceback."""


@dataclass(frozen=True)
class Tool:
    name: str
    lang: str
    cmds: tuple[str, ...]
    desc: str
    install_command: str | None

    def installed_as(self) -> str | None:
        for cmd in self.cmds:
            if shutil.which(cmd):
                return cmd
        return None


def source_dir() -> Path:
    if env := os.environ.get("CHEZMOI_SOURCE_DIR"):
        return Path(env)
    try:
        result = subprocess.run(
            ["chezmoi", "source-path"],
            capture_output=True,
            text=True,
            check=True,
        )
    except (OSError, subprocess.CalledProcessError) as err:
        raise ToolsError("cannot locate the chezmoi source directory") from err
    return Path(result.stdout.strip())


def load_tools(source: Path) -> list[Tool]:
    inventories = [("tools.toml", "tools")]
    if os.environ.get("WSL_DISTRO_NAME"):
        inventories.append(("wsl_tools.toml", "wsl_tools"))

    tools: list[Tool] = []
    for filename, key in inventories:
        path = source / ".chezmoidata" / filename
        if not path.is_file():
            continue
        with path.open("rb") as handle:
            data = tomllib.load(handle)
        for entry in data.get(key, []):
            name = entry["name"]
            tools.append(
                Tool(
                    name=name,
                    lang=entry.get("lang", ""),
                    cmds=tuple(entry.get("cmds") or [name]),
                    desc=entry.get("desc", ""),
                    install_command=entry.get("install_command"),
                )
            )
    if not tools:
        raise ToolsError(f"no tool inventory under {source / '.chezmoidata'}")
    return sorted(tools, key=lambda tool: (tool.lang, tool.name.lower()))


def find_tool(tools: list[Tool], name: str) -> Tool:
    wanted = name.lower()
    for tool in tools:
        if tool.name.lower() == wanted or wanted in (c.lower() for c in tool.cmds):
            return tool
    close = difflib.get_close_matches(name, [tool.name for tool in tools], n=3)
    hint = f", did you mean {' or '.join(close)}?" if close else ""
    raise ToolsError(f"{name}: not in the inventory{hint}")


def install_command_for(tool: Tool) -> str:
    command = tool.install_command
    if command is None:
        prefix = DERIVED_INSTALL.get(tool.lang)
        if prefix is None:
            raise ToolsError(
                f"{tool.name}: no install_command, and none follows from lang {tool.lang!r}"
            )
        command = shlex.join([*prefix, tool.name])
    elif command.startswith(UNINSTALLABLE_PREFIX):
        reason = command.removeprefix(UNINSTALLABLE_PREFIX).strip()
        raise ToolsError(f"{tool.name}: not installable on its own ({reason})")

    head, separator, tail = command.partition(" ")
    if head == "cargo":
        command = CARGO_WRAPPER + separator + tail
    return command


def spawn_argv(command: str) -> list[str]:
    if not SHELL_OPERATORS.isdisjoint(command):
        return ["cmd.exe", "/c", command] if os.name == "nt" else ["sh", "-c", command]

    argv = shlex.split(command)
    exe = shutil.which(argv[0])
    if exe is None:
        raise ToolsError(f"{argv[0]}: not on PATH")
    # CreateProcess cannot start a batch file, and the ~/.local/bin wrappers are
    # .cmd files on Windows.
    if os.name == "nt" and Path(exe).suffix.lower() in {".bat", ".cmd"}:
        return ["cmd.exe", "/c", exe, *argv[1:]]
    return [exe, *argv[1:]]


def print_rows(rows: list[tuple[str, ...]], headers: tuple[str, ...] | None) -> None:
    if not rows:
        return
    fixed = len(rows[0]) - 1
    widths = [max(len(row[i]) for row in rows) for i in range(fixed)]
    if headers:
        widths = [max(widths[i], len(headers[i])) for i in range(fixed)]
    widths[-1] = min(widths[-1], NAME_COLUMN_MAX)

    lead = sum(widths) + 2 * fixed
    room = max(shutil.get_terminal_size().columns - lead - 1, 20)
    template = "  ".join(f"{{:<{width}}}" for width in widths) + "  {}"

    if headers:
        print(template.format(*headers[:fixed], headers[fixed]))
    for row in rows:
        last = row[fixed]
        if len(last) > room:
            last = last[: room - 1] + "…"
        print(template.format(*row[:fixed], last).rstrip())


def cmd_list(tools: list[Tool], args: argparse.Namespace) -> int:
    rows: list[tuple[str, ...]] = []
    for tool in tools:
        if args.lang and tool.lang != args.lang:
            continue
        installed = tool.installed_as() is not None
        if (args.missing and installed) or (args.installed and not installed):
            continue
        rows.append(("ok" if installed else "missing", tool.lang, tool.name, tool.desc))
    print_rows(rows, ("STATE", "LANG", "NAME", "DESCRIPTION"))
    return 0


def cmd_missing(tools: list[Tool], args: argparse.Namespace) -> int:
    rows: list[tuple[str, ...]] = [
        (tool.lang, tool.name, tool.desc)
        for tool in tools
        if (not args.lang or tool.lang == args.lang) and tool.installed_as() is None
    ]
    print_rows(rows, None)
    return 0


def cmd_install(tools: list[Tool], args: argparse.Namespace) -> int:
    worst = 0
    for name in args.names:
        try:
            tool = find_tool(tools, name)
            command = install_command_for(tool)
        except ToolsError as err:
            print(err, file=sys.stderr)
            worst = max(worst, 1)
            continue

        if args.dry_run:
            print(f"would run: {command}")
            continue

        print(f"\n$ {command}", flush=True)
        try:
            argv = spawn_argv(command)
        except ToolsError as err:
            print(err, file=sys.stderr)
            worst = max(worst, 1)
            continue
        worst = max(worst, subprocess.run(argv, check=False).returncode)
    return worst


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="chezmoi tools",
        description="Report and install the tools inventoried in .chezmoidata.",
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    list_parser = subparsers.add_parser("list", help="list every inventoried tool")
    list_parser.add_argument("--lang", help="only tools written in this lang")
    state = list_parser.add_mutually_exclusive_group()
    state.add_argument("--missing", action="store_true", help="only tools not on PATH")
    state.add_argument("--installed", action="store_true", help="only tools on PATH")
    list_parser.set_defaults(func=cmd_list)

    missing_parser = subparsers.add_parser("missing", help="list tools not on PATH")
    missing_parser.add_argument("--lang", help="only tools written in this lang")
    missing_parser.set_defaults(func=cmd_missing)

    install_parser = subparsers.add_parser("install", help="run a tool's install command")
    install_parser.add_argument("names", nargs="+", metavar="NAME")
    install_parser.add_argument(
        "-n",
        "--dry-run",
        action="store_true",
        help="print the command that would run without running it",
    )
    install_parser.set_defaults(func=cmd_install)

    return parser.parse_args()


def main() -> int:
    args = parse_args()
    try:
        tools = load_tools(source_dir())
    except ToolsError as err:
        print(err, file=sys.stderr)
        return 1
    return args.func(tools, args)


if __name__ == "__main__":
    sys.exit(main())
