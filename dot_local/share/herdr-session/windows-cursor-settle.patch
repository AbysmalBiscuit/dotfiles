+    #[test]
+    fn cursor_settle_holds_previous_prompt_during_a_new_repaint_burst() {
+        for next_burst_ms in [21, 60, 201] {
+            let now = Instant::now();
+            let mut settle = CursorPositionSettleState::default();
+            let initial = cursor(3, 16, true, 6);
+            let first_letter = cursor(4, 16, true, 6);
+            let repaint_anchor = cursor(0, 14, true, 6);
+            let second_letter = cursor(5, 16, true, 6);
+
+            settle.observe(Some(initial), now);
+            settle.observe(Some(first_letter), now + Duration::from_millis(1));
+            assert_eq!(
+                settle.reported_cursor(Some(first_letter), now + Duration::from_millis(21)),
+                Some(first_letter)
+            );
+
+            let next_burst = now + Duration::from_millis(next_burst_ms);
+            settle.observe(Some(repaint_anchor), next_burst);
+            assert_eq!(
+                settle.reported_cursor(Some(repaint_anchor), next_burst),
+                Some(first_letter)
+            );
+            settle.observe(Some(second_letter), next_burst + Duration::from_millis(1));
+            assert_eq!(
+                settle.reported_cursor(Some(second_letter), next_burst + Duration::from_millis(2)),
+                Some(first_letter)
+            );
+            assert_eq!(
+                settle.reported_cursor(Some(second_letter), next_burst + Duration::from_millis(21)),
+                Some(second_letter)
+            );
+
+            let third_letter = cursor(6, 16, true, 6);
+            let third_burst = next_burst + Duration::from_millis(201);
+            settle.observe(Some(repaint_anchor), third_burst);
+            settle.observe(Some(third_letter), third_burst + Duration::from_millis(1));
+            assert_eq!(
+                settle.reported_cursor(Some(third_letter), third_burst + Duration::from_millis(2)),
+                Some(second_letter)
+            );
+            assert_eq!(
+                settle.reported_cursor(Some(third_letter), third_burst + Duration::from_millis(21)),
+                Some(third_letter)
+            );
+        }
+    }
+
+    #[test]
+    fn cursor_settle_discards_pending_position_when_cursor_disappears() {
+        let now = Instant::now();
+        let mut settle = CursorPositionSettleState::default();
+        settle.observe(Some(cursor(1, 0, true, 0)), now);
+        settle.observe(Some(cursor(2, 0, true, 0)), now + Duration::from_millis(1));
+        settle.observe(None, now + Duration::from_millis(2));
+        assert!(!settle.pending());
+        assert_eq!(
+            settle.reported_cursor(None, now + Duration::from_millis(3)),
+            None
+        );
+
+        let next = cursor(3, 0, true, 6);
+        settle.observe(Some(next), now + Duration::from_millis(201));
+        assert!(!settle.pending());
+        assert_eq!(
+            settle.reported_cursor(Some(next), now + Duration::from_millis(202)),
+            Some(next)
+        );
+    }
