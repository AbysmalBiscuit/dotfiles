+}
+
+pub fn run_client_at(args: &[String]) -> io::Result<()> {
+    let target = match args {
+        [] => None,
+        [flag, id] if !id.is_empty() => Some(match flag.as_str() {
+            "--workspace" => shell::ClientEndpointFocusTarget::Workspace(id.clone()),
+            "--tab" => shell::ClientEndpointFocusTarget::Tab(id.clone()),
+            _ => {
+                return Err(io::Error::new(
+                    io::ErrorKind::InvalidInput,
+                    "expected --workspace ID or --tab ID",
+                ))
+            }
+        }),
+        _ => {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "expected --workspace ID or --tab ID",
+            ))
+        }
+    };
+    run_client_with_mode(None, None, "connecting to server", target)
 }
 
