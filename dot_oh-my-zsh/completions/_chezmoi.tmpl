# chezmoi:template:left-delimiter="# {{" right-delimiter="}}"
# {{- if false -}}
# vim:filetype=zsh.chezmoitmpl
# {{- end -}}
# {{- completion "zsh" }}

# cobra builds the completion above from chezmoi's command tree, which the
# chezmoi-* plugins on PATH are not part of.
_chezmoi_plugins() {
    local -a candidates
    if (( CURRENT == 2 )); then
        candidates=(
# {{- range $plugin := .chezmoi_plugins }}
            '# {{ $plugin.name }}:# {{ $plugin.desc }}'
# {{- end }}
        )
        _describe 'chezmoi plugin' candidates
        return
    fi
    (( CURRENT == 3 )) || return
    case $words[2] in
# {{- range $plugin := .chezmoi_plugins }}
# {{- if index $plugin "args" }}
    # {{ $plugin.name }})
        candidates=(
# {{- range $arg := index $plugin "args" }}
            '# {{ $arg.name }}:# {{ $arg.desc }}'
# {{- end }}
        )
        _describe '# {{ $plugin.name }}' candidates
        ;;
# {{- end }}
# {{- end }}
    esac
}

# zsh runs this whole file as the body of _chezmoi on the first autoload, so by
# the time control reaches here cobra's guard above has already answered that
# call. The candidates are therefore offered inline as well as wrapped into the
# _chezmoi every later call sees.
zmodload -i zsh/parameter
functions[_chezmoi_cobra]=$functions[_chezmoi]
_chezmoi() {
    # _arguments inside the generated function may shift `words`, so the plugin
    # candidates are picked from a snapshot taken before it runs.
    local -a saved_words=("${words[@]}")
    local saved_current=$CURRENT
    _chezmoi_cobra "$@"
    words=("${saved_words[@]}")
    CURRENT=$saved_current
    _chezmoi_plugins
}

if [ "$funcstack[1]" = "_chezmoi" ]; then
    _chezmoi_plugins
fi
