{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Chezmoi tool inventory",
  "type": "object",
  "definitions": {
    "commandArguments": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "commandNames": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "shellText": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 },
      "description": "Text keyed by canonical shell name."
    },
    "installTable": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "default": { "type": "string" },
        "windows": { "type": "string" },
        "linux": { "type": "string" },
        "macos": { "type": "string" }
      },
      "description": "Install commands per platform. A platform entry overrides default; an empty string disables installation there."
    },
    "updateTable": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "default": { "$ref": "#/definitions/commandArguments" },
        "windows": { "$ref": "#/definitions/commandArguments" },
        "linux": { "$ref": "#/definitions/commandArguments" },
        "macos": { "$ref": "#/definitions/commandArguments" }
      },
      "description": "Argument arrays used to update an installed tool. A platform entry overrides default; an empty array disables updates there."
    },
    "completionsTable": {
      "type": "object",
      "required": ["command"],
      "additionalProperties": false,
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "only_if_no": { "$ref": "#/definitions/commandNames" },
        "append": { "$ref": "#/definitions/shellText" }
      }
    },
    "initTable": {
      "type": "object",
      "required": ["command"],
      "additionalProperties": false,
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "only_if_no": { "$ref": "#/definitions/commandNames" },
        "exclude_shells": { "$ref": "#/definitions/commandNames" },
        "append": { "$ref": "#/definitions/shellText" }
      }
    },
    "tool": {
      "type": "object",
      "required": ["lang", "name"],
      "additionalProperties": false,
      "x-taplo": { "initKeys": ["lang", "name"] },
      "properties": {
        "lang": {
          "type": "string",
          "minLength": 1,
          "description": "Implementation language used for sorting and grouping."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Display name and tool-level lookup key."
        },
        "cmds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 },
          "description": "Executable names checked on PATH. The sorter uses the tool name when this is omitted."
        },
        "desc": { "type": "string", "description": "Short description of the tool." },
        "url": { "type": "string", "description": "Project or documentation URL." },
        "git": { "type": "string", "description": "Source repository URL." },
        "comment": { "type": "string", "description": "Free-form inventory note." },
        "install": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "$ref": "#/definitions/installTable" }
          ],
          "description": "Command used to install the tool, for every platform or per platform."
        },
        "update": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            { "$ref": "#/definitions/updateTable" }
          ],
          "description": "Arguments used to update the tool, for every platform or per platform."
        },
        "update_on_apply": {
          "type": "boolean",
          "default": true,
          "description": "Run the declared update during chezmoi apply. Set false to update only through chezmoi tools update."
        },
        "completions": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "$ref": "#/definitions/completionsTable" }
          ],
          "description": "Command used to generate shell completions, with its modifiers."
        },
        "init": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "$ref": "#/definitions/initTable" }
          ],
          "description": "Command used to generate shell initialization code, with its modifiers."
        },
        "shells": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 },
          "description": "Shell names accepted by the completion or initialization command. The sorter uses its standard shell set when this is omitted."
        },
        "shell_arg": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 },
          "description": "Argument overrides keyed by canonical shell name, for a CLI that wants a name it does not advertise."
        },
        "shell_env": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*="
          },
          "description": "KEY=VALUE pairs exported for whichever generator command runs, for knobs a CLI reads only from the environment."
        },
        "provided_by": {
          "type": "string",
          "minLength": 1,
          "description": "Name of the package that ships this binary. Blocks install and update derivation."
        }
      }
    }
  },
  "properties": {
    "tools": { "type": "array", "items": { "$ref": "#/definitions/tool" } },
    "wsl_tools": { "type": "array", "items": { "$ref": "#/definitions/tool" } }
  },
  "additionalProperties": false,
  "minProperties": 1,
  "maxProperties": 1
}
