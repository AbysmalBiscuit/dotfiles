# chezmoi:template:left-delimiter="# {{" right-delimiter="}}"
# {{- if false -}}
# vim:filetype=ps1.chezmoitmpl:shiftwidth=4
# {{- end }}
# bat reads themes from ~/.config/bat/themes and syntaxes from
# ~/.config/bat/syntaxes, but highlights from a compiled cache, so an edited
# .tmTheme or .sublime-syntax has no effect until the cache is rebuilt.
# yazi parses the .tmTheme directly and needs nothing here.
#
# One hash per file, so chezmoi re-runs this when any of them changes. A new
# theme or syntax file needs a line here too.
# ABC: # {{ include "ABC.tmTheme" | sha256sum }}
# Catppuccin Mocha: # {{ include "private_dot_config/bat/themes/Catppuccin Mocha.tmTheme" | sha256sum }}
# bash.sublime-syntax: # {{ include "private_dot_config/bat/syntaxes/bash.sublime-syntax" | sha256sum }}
# fish.sublime-syntax: # {{ include "private_dot_config/bat/syntaxes/fish.sublime-syntax" | sha256sum }}
# gotmpl.sublime-syntax: # {{ include "private_dot_config/bat/syntaxes/gotmpl.sublime-syntax" | sha256sum }}
# json.sublime-syntax: # {{ include "private_dot_config/bat/syntaxes/json.sublime-syntax" | sha256sum }}
# lua.sublime-syntax: # {{ include "private_dot_config/bat/syntaxes/lua.sublime-syntax" | sha256sum }}
# markdown.sublime-syntax: # {{ include "private_dot_config/bat/syntaxes/markdown.sublime-syntax" | sha256sum }}
# powershell.sublime-syntax: # {{ include "private_dot_config/bat/syntaxes/powershell.sublime-syntax" | sha256sum }}
# toml.sublime-syntax: # {{ include "private_dot_config/bat/syntaxes/toml.sublime-syntax" | sha256sum }}
# yaml.sublime-syntax: # {{ include "private_dot_config/bat/syntaxes/yaml.sublime-syntax" | sha256sum }}

$ErrorActionPreference = 'Stop'

if (-not (Get-Command bat -ErrorAction SilentlyContinue)) {
    Write-Warning 'bat not installed; skipping theme cache rebuild'
    exit 0
}

# On Windows bat ignores XDG_CONFIG_HOME and looks in %APPDATA%\bat, so without
# this it would compile an empty theme set. The user-level BAT_CONFIG_DIR is not
# in this process on a first apply.
if (-not $env:BAT_CONFIG_DIR) {
    $env:BAT_CONFIG_DIR = "# {{ joinPath .chezmoi.homeDir ".config" "bat" }}"
}

bat cache --build
