#!/usr/bin/env pwsh
# chezmoi:template:left-delimiter="# {{" right-delimiter="}}"
# {{- if false -}}
# vim:filetype=ps1.chezmoitmpl
# {{- end -}}
# {{- /* ========================================================== */ -}}
# {{- /* Generate shell completions/init for PowerShell and Nushell. */ -}}
# {{- /*                                                            */ -}}
# {{- /* Loop 1: stat mtime comments for run_onchange triggering.   */ -}}
# {{- /* Loop 2: per shell, per tool. PowerShell gets one .ps1 per  */ -}}
# {{- /* tool; Nushell gets a single batched autoload file.         */ -}}
# {{- /* Init takes priority except for init.exclude_shells.         */ -}}
# {{- /* No forks at template eval — stat/lookPath are internal.    */ -}}
# {{- /*                                                            */ -}}
# {{- /* Shell naming: the spelling a tool declares in               */ -}}
# {{- /* shells is the argument it gets (see $shell_names).          */ -}}
# {{- /* shell_arg.SHELL overrides that when a CLI wants a name      */ -}}
# {{- /* it does not advertise (e.g. "power-shell" for jj).          */ -}}
# {{- /* ========================================================== */ -}}

# {{- /* ---- PowerShell: one file per tool ---- */ -}}
# {{- $out_dir := joinPath .chezmoi.homeDir ".cache" "shell-completions" -}}

# {{- /* ---- Nushell: one batched file in the user autoload dir ---- */ -}}
# {{- /* Mirrors nu-config/src/resolve.rs: XDG_CONFIG_HOME wins, else    */ -}}
# {{- /* dirs::config_dir(), which is %APPDATA% on Windows. Autoload is   */ -}}
# {{- /* always config_home/autoload, and nushell reads every .nu in it   */ -}}
# {{- /* after config.nu, skipping the directory when it does not exist.  */ -}}
# {{- $xdg := env "XDG_CONFIG_HOME" -}}
# {{- $nu_home := "" -}}
# {{- if $xdg -}}
# {{-   $nu_home = joinPath $xdg "nushell" -}}
# {{- else -}}
# {{-   $nu_home = joinPath (env "APPDATA" | default (joinPath .chezmoi.homeDir "AppData" "Roaming")) "nushell" -}}
# {{- end -}}
# {{- $nu_file := joinPath $nu_home "autoload" "_generated.nu" -}}

# {{- /* ---- Spellings a tool may use in shells for a given shell ---- */ -}}
# {{- /* CLIs disagree: clap_complete_nushell renders "nushell", watchexec wants  */ -}}
# {{- /* "nu". Whichever spelling a tool declares is the argument it receives, so */ -}}
# {{- /* shell_arg.SHELL is only needed when the two genuinely differ. Later      */ -}}
# {{- /* entries win if a tool declares more than one.                           */ -}}
# {{- $shell_names := dict "nu" (list "nu" "nushell") -}}

# {{- /* ---- Target shells: nu only when it is actually installed ---- */ -}}
# {{- $shells := list "powershell" -}}
# {{- if index $.has "nu" | default false -}}
# {{-   $shells = append $shells "nu" -}}
# {{- end -}}

# {{- /* ---- Prepare tools lists ---- */ -}}
# {{- $all_tools := .tools | default (list) -}}
# {{- $final_tools := list -}}

# {{- /* ============================================================== */ -}}
# {{- /* Loop 1: stat comments — triggers run_onchange on binary change */ -}}
# {{- /* A tool is kept when any target shell claims it, so the stat     */ -}}
# {{- /* comment is emitted once per exe rather than once per shell.     */ -}}
# {{- /* ============================================================== */ -}}
# {{- range $tool := $all_tools -}}
# {{-   $init_raw := index $tool "init" | default "" -}}
# {{-   $init_table := dict -}}
# {{-   $init_command := "" -}}
# {{-   if kindIs "map" $init_raw -}}
# {{-     $init_table = $init_raw -}}
# {{-     $init_command = index $init_raw "command" | default "" -}}
# {{-   else -}}
# {{-     $init_command = $init_raw -}}
# {{-   end -}}
# {{-   $comp_raw := index $tool "completions" | default "" -}}
# {{-   $comp_table := dict -}}
# {{-   $completions_command := "" -}}
# {{-   if kindIs "map" $comp_raw -}}
# {{-     $comp_table = $comp_raw -}}
# {{-     $completions_command = index $comp_raw "command" | default "" -}}
# {{-   else -}}
# {{-     $completions_command = $comp_raw -}}
# {{-   end -}}
# {{-   $cmd_str := $init_command | default $completions_command -}}
# {{-   if $cmd_str -}}
# {{-     $exe := $cmd_str | splitList " " | first -}}
# {{-     $has_key := $exe | replaceAllRegex "[^a-zA-Z0-9_]" "_" -}}
# {{-     if index $.has $has_key | default false -}}
# {{-       $wanted := false -}}
# {{-       $supported_shells := index $tool "shells" | default (list "bash" "fish" "zsh") -}}
# {{-       range $s := $shells -}}
# {{-         range $n := (index $shell_names $s | default (list $s)) -}}
# {{-           if has $n $supported_shells -}}
# {{-             $wanted = true -}}
# {{-           end -}}
# {{-         end -}}
# {{-       end -}}
# {{-       if $wanted -}}
# {{-         $path := lookPath $exe -}}
# {{-         if $path }}
# {{-           $_ := set $tool "exe" $exe }}
# {{-           $final_tools = append $final_tools $tool }}
# # {{ $exe }}:# {{ (stat $path).modTime }}
# {{-         end -}}
# {{-       end -}}
# {{-     end -}}
# {{-   end -}}
# {{- end }}

# {{- /* Re-run if the nushell autoload file went missing */ -}}
# {{- if has "nu" $shells -}}
# {{-   if not (stat $nu_file) }}
# missing: # {{ $nu_file }}
# {{-   end -}}
# {{- end }}

$ErrorActionPreference = 'Stop'

$outDir = "# {{ $out_dir }}"
New-Item -ItemType Directory -Path $outDir -Force | Out-Null
# Only the files generated here, never the whole tree: script 91 owns the
# downloaded subdirectory, and the profile loads both.
Get-ChildItem -Path $outDir -Filter '*.ps1' -File | Remove-Item -Force

# {{- if has "nu" $shells }}

# Nushell batches into one file, so only that file is replaced. Wiping the
# whole autoload directory would take out anything else chezmoi drops there.
$nuFile = "# {{ $nu_file }}"
New-Item -ItemType Directory -Path (Split-Path -Parent $nuFile) -Force | Out-Null
if (Test-Path $nuFile) {
    Remove-Item $nuFile -Force
}
$nuParts = [System.Collections.Generic.List[string]]::new()
# {{- end }}

# {{- /* ============================================================ */ -}}
# {{- /* Loop 2: generate, per shell then per tool                    */ -}}
# {{- /* ============================================================ */ -}}
# {{- range $shell := $shells -}}
# {{-   range $tool := $final_tools -}}
# {{- /* ---- Match any accepted spelling; the match is the default arg ---- */ -}}
# {{-     $accepted := index $shell_names $shell | default (list $shell) -}}
# {{-     $supported_shells := index $tool "shells" | default (list "bash" "fish" "zsh") -}}
# {{-     $declared := "" -}}
# {{-     range $n := $accepted -}}
# {{-       if has $n $supported_shells -}}
# {{-         $declared = $n -}}
# {{-       end -}}
# {{-     end -}}
# {{-     if $declared -}}
# {{-       $init_raw := index $tool "init" | default "" -}}
# {{-       $init_table := dict -}}
# {{-       $init_command := "" -}}
# {{-       if kindIs "map" $init_raw -}}
# {{-         $init_table = $init_raw -}}
# {{-         $init_command = index $init_raw "command" | default "" -}}
# {{-       else -}}
# {{-         $init_command = $init_raw -}}
# {{-       end -}}
# {{-       $comp_raw := index $tool "completions" | default "" -}}
# {{-       $comp_table := dict -}}
# {{-       $completions_command := "" -}}
# {{-       if kindIs "map" $comp_raw -}}
# {{-         $comp_table = $comp_raw -}}
# {{-         $completions_command = index $comp_raw "command" | default "" -}}
# {{-       else -}}
# {{-         $completions_command = $comp_raw -}}
# {{-       end -}}
# {{-       $has_comp := $completions_command | ne "" -}}
# {{-       $has_init := $init_command | ne "" -}}
# {{-       if or $has_comp $has_init -}}
# {{- /* ---- Determine which command to use and its only_if_no guard ---- */ -}}
# {{-         $use_cmd := "" -}}
# {{-         $append_table := dict -}}
# {{-         $skip := false -}}
# {{-         if and $has_init (not (has $shell (index $init_table "exclude_shells" | default (list)))) -}}
# {{-           $use_cmd = $init_command -}}
# {{-           $append_table = index $init_table "append" | default (dict) -}}
# {{-           range $blocker := index $init_table "only_if_no" | default (list) -}}
# {{-             $bkey := $blocker | replaceAllRegex "[^a-zA-Z0-9_]" "_" -}}
# {{-             if index $.has $bkey | default false -}}
# {{-               $skip = true -}}
# {{-             end -}}
# {{-           end -}}
# {{-         else if $has_comp -}}
# {{-           $use_cmd = $completions_command -}}
# {{-           $append_table = index $comp_table "append" | default (dict) -}}
# {{-           range $blocker := index $comp_table "only_if_no" | default (list) -}}
# {{-             $bkey := $blocker | replaceAllRegex "[^a-zA-Z0-9_]" "_" -}}
# {{-             if index $.has $bkey | default false -}}
# {{-               $skip = true -}}
# {{-             end -}}
# {{-           end -}}
# {{-         else -}}
# {{-           $skip = true -}}
# {{-         end -}}
# {{-         if not $skip -}}
# {{- /* ---- Shell arg: shell_arg.SHELL if set, else the declared spelling ---- */ -}}
# {{-           $shell_arg := $declared -}}
# {{-           $custom := index (index $tool "shell_arg" | default (dict)) $shell | default "" -}}
# {{-           if $custom -}}
# {{-             $shell_arg = $custom -}}
# {{-           end -}}
# {{-           $gen_cmd := $use_cmd | replace "SHELL" $shell_arg -}}
# {{-           $append := index $append_table $shell | default "" -}}
# {{-           if eq $shell "nu" }}
# {{ $gen_cmd }}# {{ $append | replaceAllRegex "\\\\n" "\n" | trimSuffix "\n" }} | Out-String -Width 8192 | ForEach-Object {
    $nuParts.Add($_)
}
# {{-           else }}
# {{ $gen_cmd }}# {{ $append | replaceAllRegex "\\\\n" "\n" | trimSuffix "\n" }} | Out-String -Width 8192 | ForEach-Object {
    [System.IO.File]::WriteAllText(
        "# {{ joinPath $out_dir (printf "%s.ps1" $tool.name) }}",
        $_,
        [System.Text.UTF8Encoding]::new($true)
    )
}
# {{-           end -}}
# {{-         end -}}
# {{-       end -}}
# {{-     end -}}
# {{-   end -}}
# {{- end }}

# {{- if has "nu" $shells }}

# No BOM: nushell's parser takes the mark as part of the first token.
if ($nuParts.Count -gt 0) {
    [System.IO.File]::WriteAllText(
        $nuFile,
        ($nuParts -join "`n"),
        [System.Text.UTF8Encoding]::new($false)
    )
}
# {{- end }}

# PowerShell completions stay one file per tool because the parser requires
# `using` statements at the top of a file, which a concatenation of several
# tools' output cannot guarantee. Nushell has no such rule, so it batches.
