$vars = @{
    # XDG variables
    XDG_CONFIG_HOME = "$HOME\.config"
    XDG_DATA_HOME   = "$HOME\.local\share"
    XDG_CACHE_HOME  = "$HOME\.cache"
    XDG_STATE_HOME  = "$HOME\.local\state"
    # tool variables
    # bat ignores XDG_CONFIG_HOME on Windows and reads %APPDATA%\bat instead
    BAT_CONFIG_DIR = "$HOME\.config\bat"
    # {{- if .has.yazi }}
    YAZI_CONFIG_HOME = "$HOME\.config\yazi"
    # {{- end}}
}
# A User-scope write broadcasts WM_SETTINGCHANGE to every top-level window and
# blocks on the slowest to answer, which costs seconds per variable. Only the
# ones whose value actually changed are worth that.
foreach ($k in $vars.Keys) {
    if ([System.Environment]::GetEnvironmentVariable($k, "User") -ne $vars[$k]) {
        [System.Environment]::SetEnvironmentVariable($k, $vars[$k], "User")
    }
}
