"""Put the herdr agent-state hook scripts in place for Claude Code and Codex.

Herdr ships those scripts and revises them between releases, so they stay out
of the chezmoi source and `herdr integration install` writes whichever one the
installed herdr carries.

Install writes wiring of its own as well. Codex hooks are managed in config.toml,
so the generated hooks.json is removed after installation. For Claude Code
the wiring lands in settings.json under hooks, which the agentcfg baseline
enforces, so the baseline carries a copy of herdr's entry verbatim and wins.
Running before the file apply is what makes that ordering hold.
"""

# # {{ if .has.herdr }}# {{ output "herdr" "integration" "status" | sha256sum }}# {{ end }}

from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path

HAS_HERDR = # {{ if .has.herdr }}True# {{ else }}False# {{ end }}

INTEGRATIONS = ("claude", "codex")


def main() -> int:
    if not HAS_HERDR:
        return 0
    for name in INTEGRATIONS:
        try:
            result = subprocess.run(
                ["herdr", "integration", "install", name],
                capture_output=True,
                text=True,
            )
        except FileNotFoundError:
            print("herdr is not on PATH; skipping integrations", file=sys.stderr)
            return 0
        if result.returncode != 0:
            print(
                f"herdr integration install {name}: "
                f"{result.stderr.strip() or result.stdout.strip()}",
                file=sys.stderr,
            )
        elif name == "codex":
            codex_dir = Path(os.environ.get("CODEX_HOME") or "~/.codex").expanduser()
            (codex_dir / "hooks.json").unlink(missing_ok=True)
    return 0


if __name__ == "__main__":
    sys.exit(main())
