#!/usr/bin/env python3
# chezmoi:template:left-delimiter="# {{" right-delimiter="}}"
# vim:filetype=python.chezmoitmpl
"""Pin GOAMD64 to the highest microarchitecture level this CPU actually runs.

A binary built for a level the CPU lacks dies with an illegal instruction, so
every candidate is probed by building and running it rather than by reading
feature flags. That costs a compile per candidate, so the answer is cached in
go_level.txt, which chezmoi also reads back as .system.go_level.
"""
# {{- if .tool.go }}

from __future__ import annotations

import os
import shutil
import subprocess
import tempfile
import time
from pathlib import Path

CONFIG_DIR = Path.home() / ".config" / "chezmoi"
LEVEL_FILE = CONFIG_DIR / "go_level.txt"
STAMP_FILE = CONFIG_DIR / "go_lvl"
MAX_CACHE_AGE = 100 * 24 * 60 * 60
PROBE_TIMEOUT = 120

# Highest first: the first one that runs is the one to keep.
LEVELS = ("v4", "v3", "v2", "v1")
PROBE_SOURCE = "package main\n\nfunc main() {}\n"


def cached_level() -> str | None:
    """The cached level, or None when it is missing, unreadable, or stale."""
    try:
        level = LEVEL_FILE.read_text(encoding="utf-8").strip()
        stamp = float(STAMP_FILE.read_text(encoding="utf-8").strip())
    except (OSError, ValueError):
        return None
    if level not in LEVELS or time.time() - stamp > MAX_CACHE_AGE:
        return None
    return level


def detect_level(go: str) -> str | None:
    """The highest level whose binary runs here, or None if none of them do."""
    env = {**os.environ, "GO111MODULE": "off"}
    with tempfile.TemporaryDirectory() as workdir:
        probe = Path(workdir) / "probe.go"
        probe.write_text(PROBE_SOURCE, encoding="utf-8")
        for level in LEVELS:
            try:
                result = subprocess.run(
                    [go, "run", str(probe)],
                    env={**env, "GOAMD64": level},
                    capture_output=True,
                    check=False,
                    timeout=PROBE_TIMEOUT,
                )
            except subprocess.TimeoutExpired:
                continue
            if result.returncode == 0:
                return level
    return None


def main() -> None:
    go = shutil.which("go")
    if go is None:
        return

    arch = subprocess.run(
        [go, "env", "GOARCH"], capture_output=True, text=True, check=True
    ).stdout.strip()
    if arch != "amd64":  # GOAMD64 only matters for amd64
        return

    level = cached_level()
    if level is None:
        level = detect_level(go)
        if level is None:  # a toolchain this broken has nothing to pin
            return
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        LEVEL_FILE.write_text(f"{level}\n", encoding="utf-8")
        STAMP_FILE.write_text(f"{int(time.time())}\n", encoding="utf-8")

    subprocess.run([go, "env", "-w", f"GOAMD64={level}"], check=True)


if __name__ == "__main__":
    main()
# {{- end }}
