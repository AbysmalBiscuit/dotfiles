#!/bin/sh
# chezmoi:template:left-delimiter="# {{" right-delimiter="}}"
# {{ if false -}}
# vim:filetype=sh.chezmoitmpl
# {{- end }}
# {{- $bash_dir := joinPath .chezmoi.homeDir ".local" "share" "bash-completion" "completions" -}}
# {{- $fish_dir := joinPath .chezmoi.homeDir ".cache" "fish" "completions" -}}
# {{- $zsh_dir := joinPath .chezmoi.homeDir ".oh-my-zsh" "completions" -}}
# {{- $nu_dir := joinPath .chezmoi.homeDir ".config" "nushell" "autoload" -}}
# {{- /* TODO: add yazi, ya, pacman */ -}}
# Completions for tools that cannot emit their own, downloaded from the project
# instead.
#
# Each file is named after the command it completes, so every shell finds it by
# its own autoload rules. Appending to the batched files script 90 writes would
# not survive: 90 rewrites those from scratch whenever any tool binary changes,
# while this script only re-runs when the tools below change. Separate files
# also keep two tools from both defining nushell's `completions` module.
#
# Downloads land in a temporary directory and are copied into place only once
# complete, so a failed fetch cannot leave a half-written completion behind.

set -eu

# {{- if or .tool.bottom .tool.bun }}

download_dir=$(mktemp -d)
trap 'rm -rf "$download_dir"' EXIT
# {{- end }}

# {{- if .tool.bottom }}
# btm: # {{ (stat (lookPath "btm")).modTime }}
curl -fsSL 'https://github.com/ClementTsang/bottom/releases/latest/download/completion.tar.gz' -o "$download_dir/completion.tar.gz"
tar -xzf "$download_dir/completion.tar.gz" -C "$download_dir" --strip-components=1
# {{- if .tool.bash }}
mkdir -p '# {{ $bash_dir }}'
cp "$download_dir/btm.bash" '# {{ joinPath $bash_dir "btm" }}'
# {{- end }}
# {{- if .tool.fish }}
mkdir -p '# {{ $fish_dir }}'
cp "$download_dir/btm.fish" '# {{ joinPath $fish_dir "btm.fish" }}'
# {{- end }}
# {{- if .tool.zsh }}
mkdir -p '# {{ $zsh_dir }}'
cp "$download_dir/_btm" '# {{ joinPath $zsh_dir "_btm" }}'
# {{- end }}
# {{- if .tool.nushell }}
mkdir -p '# {{ $nu_dir }}'
cp "$download_dir/btm.nu" '# {{ joinPath $nu_dir "btm.nu" }}'
# {{- end }}
# {{- end }}

# {{- if .tool.bun }}
# bun ships no nushell completion; carapace covers it there.
# bun: # {{ (stat (lookPath "bun")).modTime }}
# {{- if .tool.bash }}
curl -fsSL 'https://raw.githubusercontent.com/oven-sh/bun/refs/heads/main/completions/bun.bash' -o "$download_dir/bun.bash"
mkdir -p '# {{ $bash_dir }}'
cp "$download_dir/bun.bash" '# {{ joinPath $bash_dir "bun" }}'
# {{- end }}
# {{- if .tool.fish }}
curl -fsSL 'https://raw.githubusercontent.com/oven-sh/bun/refs/heads/main/completions/bun.fish' -o "$download_dir/bun.fish"
mkdir -p '# {{ $fish_dir }}'
cp "$download_dir/bun.fish" '# {{ joinPath $fish_dir "bun.fish" }}'
# {{- end }}
# {{- if .tool.zsh }}
curl -fsSL 'https://raw.githubusercontent.com/oven-sh/bun/refs/heads/main/completions/bun.zsh' -o "$download_dir/bun.zsh"
mkdir -p '# {{ $zsh_dir }}'
cp "$download_dir/bun.zsh" '# {{ joinPath $zsh_dir "_bun" }}'
# {{- end }}
# {{- end }}
