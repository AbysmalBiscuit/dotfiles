#!/usr/bin/env python3
# chezmoi:template:left-delimiter="# {{" right-delimiter="}}"
# vim:filetype=python.chezmoitmpl
"""Keep a launcher next to every python command in ~/.local/bin.

The commands themselves are cross-platform python, but neither OS runs them
under their own name: a POSIX shell will not read a .py file's extension, and
CreateProcess will not start a shebang. So each one gets a launcher in the same
directory, sh here and .cmd on Windows, named the way it is meant to be typed.

Launchers are generated, not tracked in the chezmoi source, so this rewrites
them from whatever is on disk and deletes the ones whose command is gone. Only
files carrying the marker below are ever removed, which leaves hand-written
launchers such as nvim.cmd alone.
"""

# Names and mtimes of everything in the source bin, so this re-runs whenever a
# command is added, renamed, or given a shebang:
# # {{ range (glob (joinPath .chezmoi.sourceDir "dot_local" "bin" "*")) }}# {{ base . }} # {{ (stat .).modTime }} # {{ end }}

from __future__ import annotations

import os
import stat
import sys
from pathlib import Path

BIN = Path("# {{ .chezmoi.homeDir | replaceAllRegex "\\\\" "/" }}") / ".local" / "bin"

MARKER = "chezmoi-shim:"
WINDOWS = os.name == "nt"

# Suffixes a launcher may carry. A command never has one, so this also keeps the
# scan from mistaking a launcher for the thing it launches.
LAUNCHER_SUFFIXES = frozenset({".cmd", ".bat", ".ps1", ".sh"})


def is_python_command(path: Path) -> bool:
    if path.suffix and path.suffix != ".py":
        return False
    try:
        with path.open(encoding="utf-8", errors="replace") as handle:
            first = handle.readline()
    except OSError:
        return False
    return first.startswith("#!") and "python" in first


def launcher_body(target: str) -> str:
    if WINDOWS:
        return f'@rem {MARKER} {target}\n@python3 "%~dp0{target}" %*\n'
    return (
        "#!/bin/sh\n"
        f"# {MARKER} {target}\n"
        f'exec python3 "$(dirname "$0")/{target}" "$@"\n'
    )


def launcher_name(command: Path) -> str | None:
    """The name a command wants to be typed as, or None when it already is one.

    A .py command is spelled with hyphens once it loses the extension, matching
    how the commands that already ship without one are named.
    """
    if command.suffix == ".py":
        name = command.stem.replace("_", "-")
    elif WINDOWS:
        name = command.name
    else:
        return None
    return f"{name}.cmd" if WINDOWS else name


def generated_target(path: Path) -> str | None:
    """The command a generated launcher points at, or None if it isn't one."""
    if path.is_dir():
        return None
    try:
        head = path.read_text(encoding="utf-8", errors="replace")[:512]
    except OSError:
        return None
    for line in head.splitlines():
        _, marker, rest = line.partition(MARKER)
        if marker and rest.strip():
            return rest.strip()
    # Launchers written by hand before this script existed, adopted so they are
    # rewritten with a marker rather than left to rot beside the generated ones.
    if head.startswith('@python3 "%~dp0') and head.rstrip().endswith('%*'):
        return head.split('"')[1].removeprefix("%~dp0")
    return None


def write(path: Path, body: str) -> bool:
    try:
        if path.read_text(encoding="utf-8") == body:
            return False
    except OSError:
        pass
    path.write_text(body, encoding="utf-8")
    if not WINDOWS:
        path.chmod(path.stat().st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
    print(f"python-shims: wrote {path.name}")
    return True


def main() -> int:
    if not BIN.is_dir():
        return 0

    entries = sorted(BIN.iterdir())
    generated = {path: target for path in entries if (target := generated_target(path))}

    wanted: dict[str, str] = {}
    for path in entries:
        if path in generated or path.suffix in LAUNCHER_SUFFIXES:
            continue
        if not is_python_command(path):
            continue
        if name := launcher_name(path):
            wanted[name] = path.name

    for name, target in wanted.items():
        write(BIN / name, launcher_body(target))

    for path in generated:
        if path.name in wanted:
            continue
        # A launcher for another platform, or one whose command was removed.
        path.unlink()
        print(f"python-shims: removed {path.name}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
