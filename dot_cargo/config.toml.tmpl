#:schema = https://json.schemastore.org/cargo.json
# chezmoi:template:left-delimiter="# {{" right-delimiter="}}"

[alias]
nag = "clippy -- -W clippy::pedantic -W clippy::nursery -W clippy::unwrap_used -W clippy::expect_used"
fixnags = "clippy --fix -- -W clippy::pedantic -W clippy::nursery -W clippy::unwrap_used -W clippy::expect_used"

[build]
jobs = # {{ .system.build_jobs }}
# {{- if index .has "zccache" }}
rustc-wrapper = "zccache"
# {{- else if index .has "sccache" }}
rustc-wrapper = "sccache"
# {{- end }}


[env]
# {{- if index .has "sccache" }}
# {{- $sccache_port := 4226 -}}
# {{- if .is_windows -}}
# {{- $sccache_port = 4227 -}}
# {{- end }}
SCCACHE_SERVER_PORT = "# {{ $sccache_port }}"
# {{- end }}
# {{- if index .has "zccache" }}
# {{-   $xdg_runtime_dir := env "XDG_RUNTIME_DIR" }}
# {{-   if and (not $xdg_runtime_dir) .is_linux }}
# {{-     $xdg_runtime_dir = printf "/run/user/%s" (output "id" "-u" | trim) }}
# {{-   end }}
# {{-   if $xdg_runtime_dir }}
# Builds started without a login session still reach the same zccache socket.
XDG_RUNTIME_DIR = # {{ $xdg_runtime_dir | quote }}
# {{-   end }}
# {{- end }}

[profile.dev]
debug = "line-tables-only"
# {{- if and (not (index .has "zccache")) (index .has "sccache") }}
# sccache cannot cache incrementally compiled crates, so leaving
# incremental on costs a cache miss on every local crate.
incremental = false
# {{- else }}
incremental = true
# {{- end }}

[profile.dev.package."*"]
debug = false

[target.'cfg(target_os = "linux")']
rustflags = [
  # {{- if index .has "mold" }}
  "-C",
  "link-arg=-fuse-ld=mold",
  # {{- end }}
]
