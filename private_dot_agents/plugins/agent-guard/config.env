# agent-guard settings. Sourced by ~/.local/bin/agent-guard.
#
# This is the global layer, and on its own it does nothing: the hook runs only
# where some directory at or above the working directory holds
# .agents/plugins/agent-guard/ (tracked) or .agents/plugins/agent-guard.local/
# (machine-local). Those are discovered by walking up from the working
# directory, outermost first, so a checkout layers over the directory holding
# every checkout of that project, which layers over this file. A root holds a
# rules/ directory, a config.env, or both; it needs its own sgconfig.yml only to
# register a custom language. Each config.env is sourced in that order, so a
# nearer one tightens any setting below without editing it.
#
# Run `agent-guard doctor` inside a tree to list the roots actually found.

# Blocking is off until the rules prove they stay quiet on good code.
# Set to 1 to let Stop/SubagentStop actually refuse to finish.
AGENT_GUARD_BLOCK=0

# Cap on how many times one session may be blocked before the hook downgrades
# itself to advisory. There is no built-in loop protection on Stop hooks.
AGENT_GUARD_MAX_BLOCKS=2

# Cross-file analysis via fallow on Stop/SubagentStop. Set to 0 for per-file only.
AGENT_GUARD_FALLOW=1
AGENT_GUARD_FALLOW_TIMEOUT=45

# Findings shown per report, so feedback stays inside working memory.
AGENT_GUARD_MAX_FINDINGS=8

# Exported functions reference-counted per changeset, bounding a wide diff.
AGENT_GUARD_MAX_SYMBOLS=40

# Flag an export whose only consumer is its own test. Set to 0 where a parity
# test is deliberately the sole caller of a path still being migrated onto.
AGENT_GUARD_TEST_ONLY=1

# Also flag exported functions with exactly one caller. Off by default: a single
# caller is often a legitimate module boundary, and the rule is noisy.
AGENT_GUARD_SINGLE_CALLER=0

# Which files the per-file rules run on. A repo whose rules target another
# language widens this in its own config.env.
# AGENT_GUARD_EXTENSIONS='\.(ts|tsx|mts|cts|gd)$'

# Paths whose duplication is generated rather than written. This holds only the
# shapes every TypeScript tree shares; a project names its own generated
# directories through AGENT_GUARD_IGNORE_EXTRA, which is appended to this rather
# than replacing it.
# AGENT_GUARD_IGNORE='\.gen\.|/generated/|/__generated__/|\.d\.ts$'
# AGENT_GUARD_IGNORE_EXTRA='(db-types|api-client)/'
