%YAML 1.2
---
# Overlays Go template actions on Lua. The empty match pushes the base
# syntax so with_prototype reaches every context it enters, which is what makes
# {{ }} highlight inside base-language strings rather than only at top level.
name: Lua (Go template)
scope: source.lua.gotmpl
file_extensions:
  - lua.tmpl
contexts:
  main:
    - match: ''
      push:
        - include: scope:source.lua
      with_prototype:
        - include: scope:source.gotmpl#action
