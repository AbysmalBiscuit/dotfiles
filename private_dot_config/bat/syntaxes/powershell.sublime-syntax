%YAML 1.2
---
# Overlays Go template actions on PowerShell. The empty match pushes the base
# syntax so with_prototype reaches every context it enters, which is what makes
# {{ }} highlight inside base-language strings rather than only at top level.
name: PowerShell (Go template)
scope: source.powershell.gotmpl
file_extensions:
  - ps1.tmpl
contexts:
  main:
    - match: ''
      push:
        - include: scope:source.powershell
      with_prototype:
        - include: scope:source.gotmpl#action
