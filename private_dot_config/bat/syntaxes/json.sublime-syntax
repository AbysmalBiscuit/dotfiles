%YAML 1.2
---
# Overlays Go template actions on JSON. The empty match pushes the base
# syntax so with_prototype reaches every context it enters, which is what makes
# {{ }} highlight inside base-language strings rather than only at top level.
name: JSON (Go template)
scope: source.json.gotmpl
file_extensions:
  - json.tmpl
contexts:
  main:
    - match: ''
      push:
        - include: scope:source.json
      with_prototype:
        - include: scope:source.gotmpl#action
