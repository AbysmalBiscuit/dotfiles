# yaml-language-server: $schema=https://raw.githubusercontent.com/jesseduffield/lazygit/master/schema/config.json
# chezmoi:template:left-delimiter="# {{" right-delimiter="}}"
# git:
#   overrideGpg: true
# {{ if and .is_windows (index .has "nvim" | default false) }}
os:
  editPreset: "nvim"
# {{- end }}
# {{ if index .tool "delta" }}
git:
  # Lazygit ignores core.pager and sets GIT_PAGER from here, running the pager
  # in a pty sized to the diff panel. The wrapper therefore measures the panel
  # rather than the terminal, and picks side-by-side above its threshold. The
  # threshold is lower than git's because the panel is a fraction of the width.
  # Press `|` to fall through to the plain entry.
  diffRenderers:
# {{- if .path.python }}
    - command: DELTA_SIDE_BY_SIDE_MIN_COLUMNS=140 '# {{ .path.python }}' '# {{ joinPath .chezmoi.homeDir ".local" "bin" "git-delta-pager.py" | replaceAllRegex "\\\\" "/" }}' --dark --paging=never
# {{- end }}
    - command: delta --dark --paging=never
# {{- end }}
