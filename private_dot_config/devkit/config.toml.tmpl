#:schema https://github.com/AbysmalBiscuit/devkit/releases/latest/download/devkit-config.json
#:toml-version 1.0
# chezmoi:template:left-delimiter="# {[{" right-delimiter="}]}"

# {[{ $alacritree := index .tool "alacritree_exe" | default (index .tool "alacritree") | default "" }]}
# {[{ $herdr := index .tool "herdr" | default "" }]}

[defaults]
# worktree_root = "~/Git/example-worktrees"
# branch_prefix = "you/"
# baseline_ref = "origin/staging"
# baseline_path = "~/Git/example/_baseline"

[harness]
enforce_writes = true
enforce_commands = true

[harness.commands.worktree-add]
programs = ["git"]
args = ["worktree", "add"]
reason = "Use devkit's issue binary to create worktrees: issue setup --summary --slug [branch-name]"

[harness.commands.worktree-remove]
programs = ["git"]
args = ["worktree", "remove"]
reason = "Use devkit's issue binary to remove worktrees: issue end [branch-name]"

# Explicit rules take priority over derived task guards and explain the
# arguments needed to select commit contents.
[harness.commands.git-commit]
programs = ["git"]
args = ["commit"]
reason = """Name the paths and commit them in one step:
  devrun task commit --arg files='src/a.rs,src/b.rs' --arg commit_subject='fix(scope): imperative subject'
`files` is comma-separated, with whitespace preserved in each path. Unrelated staged paths stay staged. \
Optional: `--arg commit_body='why this change is needed'`. Agents must pass `--arg coauthors='Name <email>; Other <email>'`, `;`-separated; optional for humans. \
For Codex, use `--arg coauthors='Codex <noreply@openai.com>'`. \
For Claude Code, use `--arg coauthors='MODEL <noreply@anthropic.com>'`, replacing `MODEL` with the full model name actually used, for example `Claude Opus 5`. \
To commit part of a file, write a patch against HEAD and run `devrun task commit-patch --arg patch=<file>` with the same message args. \
To rewrite the last commit, `devrun task commit-amend` with the message args and no files."""

[harness.commands.git-add]
programs = ["git"]
args = ["add"]
reason = """`devrun task commit` stages the paths it commits, so there is nothing to stage first:
  devrun task commit --arg files='src/a.rs,src/b.rs' --arg commit_subject='fix(scope): imperative subject'
To commit part of a file, write those hunks to a patch and pass it instead:
  devrun task commit-patch --arg patch=/tmp/partial.diff --arg commit_subject='fix(scope): imperative subject'
The patch must apply to HEAD. The task commits its hunks and preserves unrelated staged changes, including independent hunks in the same file."""

[harness.commands.pr-create]
programs = ["gh"]
args = ["pr", "create"]
reason = """Open the PR with devkit: `issue pr create --pr-title 'type(scope): subject' --pr-body '<markdown>'`.
It opens ready for review; pass `--draft` when a draft was asked for. `issue pr create -h` lists the rest.
`--pr-body` becomes the agent summary. This worktree's own issue comes from `.devkit/issue.toml` and the template writes its closing line, so mention only other issues, and leave the TL;DR section for a human to fill.
Each template variable is passed as `--arg key=value`:
  agent_model='Claude Opus 5' and agent_harness='[Claude Code](https://claude.com/claude-code)' render the attribution block; agents must pass both
  refs='Closes ADA-124; Refs #90' names every other issue, `;`-separated, each carrying its own keyword
  issue_magic_word=Refs when this branch does not finish its own issue (default Closes)
  implemented_by='<who did which part>' adds one prose line above the credit"""

[harness.commands.sudo]
programs = ["sudo"]
reason = "Never run sudo"

[hooks]
after_worktree_create = [
  # {[{ if $alacritree }]}
  # A new worktree is not in alacritree's worktree list yet, so path resolution
  # cannot find its project; rescan them all instead.
  ["{{ alacritree }}", "project", "refresh", "--all"],
  # {[{ end }]}
  ["zoxide", "add", "{{ worktree }}"],
  # {[{ if $herdr }]}
  ["{{ herdr_session }}", "open", "--no-focus", "--path", "{{ worktree }}"],
  # {[{ end }]}
]

# {[{ if $herdr }]}
after_worktree_remove = [
  [
    "{{ herdr_session }}",
    "close",
    "--if-idle",
    "--path",
    "{{ worktree }}",
  ],
]
# {[{ end }]}

# {[{ if $alacritree }]}
after_end = [["{{ alacritree }}", "project", "refresh"]]
# {[{ end }]}

[apps]

# Git needs new paths in the index before a path-limited commit can name them.
[tasks.commit]
description = "Stage the given paths and commit them with a Conventional Commits message"
steps = [{ task = "commit-stage" }, { task = "commit-write" }]

[tasks.commit-stage]
description = "Stage exactly the given paths, new files included"
guard = false
run = [
  "git",
  "--literal-pathspecs",
  "add",
  "--",
  { split = "{{ files }}", on = "," },
]

# The same pathspec at commit time excludes other sessions' staged changes.
[tasks.commit-write]
description = "Commit the selected paths while preserving unrelated staging"
guard = false
run = ["git", "--literal-pathspecs", "commit", "--only", "-m", '''
{{- commit_subject | trim }}
{%- if commit_body | trim %}

{{ commit_body | trim }}
{%- endif %}
{%- if coauthors | trim(" ;") %}
{% for c in coauthors | split(";") | map("trim") | reject("eq", "") %}
Co-authored-by: {{ c }}
{%- endfor %}
{%- endif %}
''', "--", { split = "{{ files }}", on = "," }]

[tasks.commit-patch]
description = "Commit a patch against HEAD while preserving unrelated staging"
guard = false
run = [
  "{{ python }}",
  "{{ git_commit_patch }}",
  "--patch",
  "{{ patch }}",
  "--message",
  '''
{{- commit_subject | trim }}
{%- if commit_body | trim %}

{{ commit_body | trim }}
{%- endif %}
{%- if coauthors | trim(" ;") %}
{% for c in coauthors | split(";") | map("trim") | reject("eq", "") %}
Co-authored-by: {{ c }}
{%- endfor %}
{%- endif %}
''',
]

[tasks.commit-amend]
description = "Rewrite the last commit message while preserving staged changes"
guard = false
run = ["git", "commit", "--amend", "--only", "-m", '''
{{- commit_subject | trim }}
{%- if commit_body | trim %}

{{ commit_body | trim }}
{%- endif %}
{%- if coauthors | trim(" ;") %}
{% for c in coauthors | split(";") | map("trim") | reject("eq", "") %}
Co-authored-by: {{ c }}
{%- endfor %}
{%- endif %}
''']

[templates]

branch = '''
{%- set id = (issue | lower ~ "-") if issue else "" -%}
{{ id }}{{ (slug | trim | lower | replace(" ", "-"))[:46 - (id | length)] | trim("-") }}
'''
worktree_dir = '''
{%- set id = (issue | lower ~ "-") if issue else "" -%}
{{ id }}{{ (slug | trim | lower | replace(" ", "-"))[:46 - (id | length)] | trim("-") }}
'''

# PR body for `issue pr create`; `input` comes from `--pr-body`.
# Only a human supplies `human_tldr`.
pr_body = '''
{%- set own = (issue_magic_word ~ " " ~ ("#" if issue and issue[0] in "0123456789" else "") ~ issue) if issue else "" -%}
{%- set ref_lines = ((own ~ ";" ~ refs) if own else refs) | split(";") | map("trim") | reject("eq", "") | list -%}
{%- set agent = agent_model or agent_harness -%}
## TL;DR (human written)
{{ human_tldr }}
{%- if ref_lines %}

---

{{ ref_lines | join("\n") }}
{%- endif %}
{%- if agent %}

---

## Agent summary
{%- endif %}

{{ input | trim }}
{%- if agent %}

---
{%- if implemented_by | trim %}

Implemented by {{ implemented_by | trim }}
{%- endif %}

🤖 Generated with {{ agent_model }}{% if agent_model and agent_harness %} via {% endif %}{{ agent_harness }}
{%- endif %}
'''

# Defaults for optional task arguments and shared template values.
[templates.variables]

python = '# {[{ .path.python }]}'
git_commit_patch = '# {[{ joinPath .chezmoi.homeDir ".local" "bin" "git-commit-patch.py" }]}'

alacritree = "# {[{ $alacritree }]}"
herdr_session = "herdr-session# {[{ if .is_windows }]}.cmd# {[{ end }]}"

# Subject line, body and `Co-Authored-By:` trailers of a `devrun task commit`
# message. `coauthors` is `;`-separated, each entry a full `Name <email>`.
commit_subject = ""
commit_body = ""
coauthors = { default = "", required = "agents" }

# Filled by a human after the PR is open; agents leave it empty.
human_tldr = ""

# The worktree's own issue, supplied by the render context in a worktree that
# `issue setup` created. Declared here so the template also renders outside one.
issue = ""

# Magic word for the worktree's own issue. `Closes` on a branch that finishes
# it, `Refs` on one that does not.
issue_magic_word = "Closes"

# Every other issue line, verbatim and `;`-separated, so one PR can mix
# trackers and magic words:
#   --arg refs='Closes ENG-1234; Closes #90; Refs #3'
refs = ""

# Attribution for the agent summary. `agent_harness` carries the markdown link
# a harness wants in its credit line; `implemented_by` is the free-prose
# sentence naming who did which part of the work.
agent_model = { default = "", required = "agents" }
agent_harness = { default = "", required = "agents" }
implemented_by = ""
