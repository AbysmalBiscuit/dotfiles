#:schema https://github.com/AbysmalBiscuit/devkit/releases/latest/download/devkit-config.json
# chezmoi:template:left-delimiter="# {[{" right-delimiter="}]}"

# {[{ $alacritree := index .tool "alacritree_exe" | default (index .tool "alacritree") | default "" }]}
# {[{ $herdr := index .tool "herdr" | default "" }]}

[defaults]
# worktree_root = "~/Git/example-worktrees"
# branch_prefix = "you/"
# baseline_ref = "origin/staging"
# baseline_path = "~/Git/example/_baseline"

[harness]
enforce_writes = true
enforce_commands = true

[harness.commands.worktree-add]
programs = ["git"]
args = ["worktree", "add"]
reason = "Use devkit's issue binary to create worktrees: issue setup --summary --slug [branch-name]"

[harness.commands.worktree-remove]
programs = ["git"]
args = ["worktree", "remove"]
reason = "Use devkit's issue binary to remove worktrees: issue end [branch-name]"

# An explicit rule rather than the `commit` task's own `guard`, because the
# derived redirect message talks about app directories and ports and says
# nothing about the arguments the message is built from. Rules are consulted
# before tasks, so this reason is the one the agent sees.
[harness.commands.git-commit]
programs = ["git"]
args = ["commit"]
reason = """Stage first, then commit through the task that renders the message:
  devrun task commit --arg commit_subject='fix(scope): imperative subject' \
--arg commit_body=$'first line\\nsecond line' \
--arg coauthors='Claude Opus 5 <noreply@anthropic.com>; Codex GPT-6-Astra <codex@openai.com>'
commit_body and coauthors are optional; coauthors is a `;`-separated list. \
To rewrite the last commit use `devrun task commit-amend` with the same args."""

[harness.commands.pr-create]
programs = ["gh"]
args = ["pr", "create"]
reason = """Open the PR with devkit: `issue pr create --pr-title 'type(scope): subject' --pr-body '<markdown>'`.
It opens ready for review; pass `--draft` when a draft was asked for. `issue pr create -h` lists the rest.
`--pr-body` becomes the agent summary. This worktree's own issue comes from `.devkit/issue.toml` and the template writes its closing line, so mention only other issues, and leave the TL;DR section for a human to fill.
Each template variable is passed as `--arg key=value`:
  agent_model='Claude Opus 5' and agent_harness='[Claude Code](https://claude.com/claude-code)' render the attribution block; omitting both leaves the PR body with no agent credit
  refs='Closes ADA-124; Refs #90' names every other issue, `;`-separated, each carrying its own keyword
  issue_magic_word=Refs when this branch does not finish its own issue (default Closes)
  implemented_by='<who did which part>' adds one prose line above the credit"""

[hooks]
after_worktree_create = [
  # {[{ if $alacritree }]}
  # A new worktree is not in alacritree's worktree list yet, so path resolution
  # cannot find its project; rescan them all instead.
  ["{{ alacritree }}", "project", "refresh", "--all"],
  # {[{ end }]}
  ["zoxide", "add", "{{ worktree }}"],
  # {[{ if $herdr }]}
  ["{{ herdr_session }}", "open", "--path", "{{ worktree }}"],
  # {[{ end }]}
]

# {[{ if $herdr }]}
after_worktree_remove = [
  [
    "{{ herdr_session }}",
    "close",
    "--path",
    "{{ worktree }}",
  ],
]
# {[{ end }]}

# {[{ if $alacritree }]}
after_end = [["{{ alacritree }}", "project", "refresh"]]
# {[{ end }]}

[apps]

# Conventional Commits message, built by `devrun task commit`. `git commit` is
# refused by the rule above so the trailers cannot be forgotten.
[tasks.commit]
description = "Commit staged changes with a Conventional Commits message and agent co-author trailers"
guard = false
run = ["git", "commit", "-m", '''
{{- commit_subject | trim }}
{%- if commit_body | trim %}

{{ commit_body | trim }}
{%- endif %}
{%- if coauthors | trim(" ;") %}
{% for c in coauthors | split(";") | map("trim") | reject("eq", "") %}
Co-authored-by: {{ c }}
{%- endfor %}
{%- endif %}
''']

# Same message, rewriting the last commit instead of adding one. Separate task
# because a task's argv is fixed: an empty `--amend` slot would reach git as an
# empty argument rather than disappearing.
[tasks.commit-amend]
description = "Rewrite the last commit with a fresh message and agent co-author trailers"
guard = false
run = ["git", "commit", "--amend", "-m", '''
{{- commit_subject | trim }}
{%- if commit_body | trim %}

{{ commit_body | trim }}
{%- endif %}
{%- if coauthors | trim(" ;") %}
{% for c in coauthors | split(";") | map("trim") | reject("eq", "") %}
Co-authored-by: {{ c }}
{%- endfor %}
{%- endif %}
''']

[templates]

# Body of a PR opened by `issue review request` / `issue pr create`.
# `{{ input }}` is the `--pr-body` argument and lands under the agent-summary
# heading; the TL;DR section above it stays empty unless a human passes
# `human_tldr`.
pr_body = '''
{%- set own = (issue_magic_word ~ " " ~ ("#" if issue and issue[0] in "0123456789" else "") ~ issue) if issue else "" -%}
{%- set ref_lines = ((own ~ ";" ~ refs) if own else refs) | split(";") | map("trim") | reject("eq", "") | list -%}
{%- set agent = agent_model or agent_harness -%}
## TL;DR (human written)
{{ human_tldr }}
{%- if ref_lines %}

---

{{ ref_lines | join("\n") }}
{%- endif %}
{%- if agent %}

---

## Agent summary (the rest is not human-written)
{%- endif %}

{{ input | trim }}
{%- if agent %}

---
{%- if implemented_by | trim %}

Implemented by {{ implemented_by | trim }}
{%- endif %}

🤖 Generated with {{ agent_model }}{% if agent_model and agent_harness %} via {% endif %}{{ agent_harness }}
{%- endif %}
'''

# Declared so the templates above render (an undefined name is a hard error
# under strict minijinja) and so `--arg` accepts them: `--arg` is checked
# against this table, not against the template.
[templates.variables]

alacritree = "# {[{ $alacritree }]}"
herdr_session = "herdr-session# {[{ if .is_windows }]}.cmd# {[{ end }]}"

# Subject line, body and `Co-Authored-By:` trailers of a `devrun task commit`
# message. `coauthors` is `;`-separated, each entry a full `Name <email>`.
commit_subject = ""
commit_body = ""
coauthors = ""

# Filled by a human after the PR is open; agents leave it empty.
human_tldr = ""

# The worktree's own issue, supplied by the render context in a worktree that
# `issue setup` created. Declared here so the template also renders outside one.
issue = ""

# Magic word for the worktree's own issue. `Closes` on a branch that finishes
# it, `Refs` on one that does not.
issue_magic_word = "Closes"

# Every other issue line, verbatim and `;`-separated, so one PR can mix
# trackers and magic words:
#   --arg refs='Closes ENG-1234; Closes #90; Refs #3'
refs = ""

# Attribution for the agent summary. `agent_harness` carries the markdown link
# a harness wants in its credit line; `implemented_by` is the free-prose
# sentence naming who did which part of the work.
agent_model = ""
agent_harness = ""
implemented_by = ""
