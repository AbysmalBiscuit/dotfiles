# chezmoi:template:left-delimiter="# {{" right-delimiter="}}"
[font]
fallback = [
  "MesloLGM Nerd Font Propo",
  "Atkinson Hyperlegible Mono",
  "Noto Sans Mono CJK KR",
  "Noto Sans Mono CJK SC",
  "Noto Sans Mono CJK HK",
  "Noto Sans Mono CJK JP",
  "Noto Sans Mono CJK TC",
  "Menlo",
  "Monaco",
  "Consolas",
  "Twemoji Mozilla",
  "Noto Color Emoji",
  "Apple Color Emoji",
  "Segoe UI Emoji",
  "Segoe UI Symbol",
  "Symbols Nerd Font",
  "Font Awesome 6 Pro",
  "Noto Emoji",
  "Segoe UI Historic",
  "Noto Sans Bamum",
]

# confirm close only while a process is running; closing the last session
# navigates to the project main / home instead of respawning in place
[ui]
confirm_session_close = "busy"
last_session_close = "navigate"
# a removal moves the terminal to the neighbouring row rather than the first
sidebar_focus = "follow"
# PR status badges on worktree rows (polls gh)
pr_status = true
# clicking a sidebar moves keyboard focus to it
sidebar_click_focus = true
# a sidebar query reaches every row; the toggle filters resume when it empties
search_scope = "all"
# every row offers its full name on hover, so sweeping the list never falls back
# to the half-second delay on a name that happens to fit
sidebar_tooltips = "always"
# hold attention pings and drop them if the agent resumes within the window
attention_grace_ms = 2000
# restart required — present each frame as soon as it is drawn
vsync = false

# zed-style paths: filename first, parent trailing it, $HOME as ~
# the git header is a directory, so it abbreviates instead of reordering
[ui.path_style]
diff_title = "zed"
git_rows = "zed"
git_header = "fish"

[ui.path_style.filename]
bold = true

# list session rows even for single-session workspaces
[ui.session_display]
sidebar_always = true

# sidebar/chrome text: the unset default is 80% of the 12pt terminal font
# (9.6pt); this key sets the size directly, so +1pt = 10.6
[ui.font]
size = 10.6

# outline the focused side panel
[ui.focus_outline]
sidebar = true

# {{- if .is_windows }}

[terminal.shell]
program = "pwsh"
args = ["-NoLogo"]

[[ui.profiles]]
name = "WSL"
program = "wsl.exe"

[[ui.profiles]]
name = "cmd"
program = "cmd.exe"
# {{- end }}
