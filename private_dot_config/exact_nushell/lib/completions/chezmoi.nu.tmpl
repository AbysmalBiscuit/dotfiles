# chezmoi:template:left-delimiter="# {{" right-delimiter="}}"
# Plugin subcommands for `chezmoi`, on top of what carapace answers with.
#
# carapace builds its chezmoi spec from cobra's command tree, which the
# chezmoi-* scripts on PATH are not part of. An `extern "chezmoi cache"` would
# be the obvious fix and is the wrong one: declaring any chezmoi subcommand
# makes nushell complete the command name internally and stop calling the
# external completer, so the real subcommands disappear. Wrapping the completer
# keeps both.
#
# `cm` needs the same answer and cannot get it the same way: it is a custom
# command, not an external one, so nushell resolves its arguments through the
# call machinery and never reaches the external completer at all. The
# `nu-complete chezmoi` below is what lib/chezmoi.nu hangs on its rest argument.
#
# Sourced from config.nu like the rest of lib/completions. `source` splices the
# code in, so this sees the completer that block already installed.

const CHEZMOI_PLUGINS = [
# {{- range $plugin := .chezmoi_plugins }}
    { value: "# {{ $plugin.name }}", description: "# {{ $plugin.desc }}" }
# {{- end }}
]

const CHEZMOI_PLUGIN_ARGS = {
# {{- range $plugin := .chezmoi_plugins }}
# {{-   if index $plugin "args" }}
    "# {{ $plugin.name }}": [
# {{-     range $arg := index $plugin "args" }}
        { value: "# {{ $arg.name }}", description: "# {{ $arg.desc }}" }
# {{-     end }}
    ]
# {{-   end }}
# {{- end }}
}

# Keyed by the subcommand words already typed, so a nested subcommand's flags
# and its parent's stay apart without any position arithmetic.
const CHEZMOI_PLUGIN_FLAGS = {
# {{- range $plugin := .chezmoi_plugins }}
# {{-   if index $plugin "flags" }}
    "# {{ $plugin.name }}": [
# {{-     range $flag := index $plugin "flags" }}
        { value: "--# {{ $flag.name }}", description: "# {{ $flag.desc }}" }
# {{-     end }}
    ]
# {{-   end }}
# {{-   range $arg := (index $plugin "args" | default (list)) }}
# {{-     if index $arg "flags" }}
    "# {{ $plugin.name }} # {{ $arg.name }}": [
# {{-       range $flag := index $arg "flags" }}
        { value: "--# {{ $flag.name }}", description: "# {{ $flag.desc }}" }
# {{-       end }}
    ]
# {{-     end }}
# {{-   end }}
# {{- end }}
}

let chezmoi_base_completer = $env.config.completions.external.completer

$env.config.completions.external.completer = {|spans|
    let base = if ($chezmoi_base_completer | describe) == "closure" {
        do $chezmoi_base_completer $spans
    } else {
        null
    }

    if ($spans.0 | path basename | str replace --regex '\.exe$' '') != "chezmoi" {
        return $base
    }

    # The last span is the word being typed, so its index is the position being
    # completed: 1 is the subcommand, 2 that subcommand's own argument.
    let typed = ($spans | last)
    let extra = if ($typed | str starts-with "-") {
        # Every plugin answers -h at every depth, so help is added here rather
        # than repeated for each one in .chezmoidata. Anything that is not a
        # plugin is carapace's to answer.
        if ($spans.1? in ($CHEZMOI_PLUGINS | get value)) {
            ($CHEZMOI_PLUGIN_FLAGS | get --optional ($spans | skip 1 | drop 1 | str join " ") | default []) ++ $HELP_FLAGS
        } else { [] }
    } else {
        match (($spans | length) - 1) {
            1 => $CHEZMOI_PLUGINS,
            2 => ($CHEZMOI_PLUGIN_ARGS | get --optional $spans.1 | default []),
            # `agents remove` takes config paths, which no static table can hold,
            # and it takes several, so every position past the second answers the
            # same.
            _ => (if ($spans.1? == "agents") and ($spans.2? == "remove") {
                nu-complete agentcfg paths
            } else { [] }),
        }
    } | where ($it.value | str starts-with $typed)

    if ($extra | is-empty) { $base } else { ($base | default []) ++ $extra }
}

# Completions for the `cm` wrapper, routed back through the completer above
# under the name it stands in for. Aliases resolve first: a completer is handed
# the raw buffer, so `cmexe ` arrives as itself rather than as `cm
# execute-template `.
def "nu-complete chezmoi" [context: string] {
    let words = ($context | str trim --left | split row --regex '\s+')
    let expansion = (scope aliases | where name == ($words | first) | get --optional 0.expansion)
    let spans = if ($expansion | is-not-empty) {
        ($expansion | split row --regex '\s+') ++ ($words | skip 1)
    } else {
        $words
    }

    let completer = $env.config.completions.external.completer
    if ($completer | describe) != "closure" { return [] }
    do $completer (["chezmoi"] ++ ($spans | skip 1))
}
